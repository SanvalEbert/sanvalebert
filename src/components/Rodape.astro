---
import Perfis from './Perfis.astro';
import { link, type Idioma } from '../data/site';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
  comercial?: boolean;
}

const { idioma, comercial = true } = Astro.props;
const txt = t(idioma);
---

<footer id="rodape" class="conteudo rodape">
  <div class="topo">
    <div class="assinatura">
      <p class="nome">Sanval <em>Ebert</em></p>
      <p class="rotulo">{txt.site.selo}</p>
    </div>

    <nav aria-label={idioma === 'pt' ? 'Redes e perfis' : 'Social and research profiles'} class="redes">
      <p class="rotulo destaque">{idioma === 'pt' ? 'Conecte-se comigo' : 'Connect with me'}</p>
      <Perfis />
    </nav>

    {comercial && <a class="botao" href={link('contratar', idioma)}>{txt.site.contratar}</a>}
  </div>

  <p class="apoio direitos">
    <span>{txt.rodape.direitos}</span>
    <span aria-hidden="true"> · </span>
    <a href={link('privacidade', idioma)}>{idioma === 'pt' ? 'Privacidade e Segurança' : 'Privacy and Security'}</a>
  </p>
</footer>

<style>
  .rodape {
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .topo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }

  .assinatura {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nome {
    font-size: 36px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .redes { max-width: 520px; }

  .direitos {
    margin-top: 32px;
  }
</style>
