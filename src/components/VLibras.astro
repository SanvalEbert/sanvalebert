---
// Widget oficial do VLibras (gov.br): traduz o conteúdo em português para Libras.
// Só é incluído nas páginas em português. O script é carregado do servidor do governo
// depois que a página termina de carregar, para não atrasar a leitura.

// Marcação exigida pelo widget (os atributos "vw" são definidos por ele).
const marcacao = `<div vw class="enabled">
  <div vw-access-button class="active"></div>
  <div vw-plugin-wrapper><div class="vw-plugin-top-wrapper"></div></div>
</div>`;
---

<Fragment set:html={marcacao} />

<script is:inline>
  window.addEventListener('load', function () {
    var s = document.createElement('script');
    s.src = 'https://vlibras.gov.br/app/vlibras-plugin.js';
    s.onload = function () {
      new window.VLibras.Widget('https://vlibras.gov.br/app');
    };
    document.body.appendChild(s);
  });
</script>
