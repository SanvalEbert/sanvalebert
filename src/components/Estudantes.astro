---
// Página Resultados dos estudantes, compartilhada pelas versões em português e em inglês.
import Base from '../layouts/Base.astro';
import { endereco, type Idioma } from '../data/site';
import RegistrosAmsterdam from './RegistrosAmsterdam.astro';
import { tp } from '../i18n/paginas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const e = tp(idioma).estudantes;
---

<Base idioma={idioma} pagina="estudantes" titulo={e.titulo} descricao={e.descricao}>
  <section class="conteudo secao">
    <div class="coluna abre">
      <p class="rotulo destaque">{e.rotulo}</p>
      <h1 class="titulo-pagina">{e.chamada[0]} <em>{e.chamada[1]}</em></h1>
      <p class="abertura">{e.resumo}</p>
    </div>
  </section>

  <section class="conteudo secao resultado" aria-labelledby="engage">
    <figure class="figura">
      <img class="foto-evento" src={endereco('images/engage-agent-amsterdam-2026.jpg')} width="1399" height="933" alt={idioma === 'pt' ? 'Premiação do Engage-Agent com o cheque de segundo lugar e as bandeiras do Brasil e do SENAI CIMATEC' : 'Engage-Agent award ceremony with the second-place cheque and the Brazilian and SENAI CIMATEC flags'} fetchpriority="high" />
      <figcaption>{e.fig1}</figcaption>
    </figure>
    <div class="coluna">
      <p class="apoio rotulo">{e.destaqueRotulo}</p>
      <h2 id="engage">{e.destaqueTitulo[0]} <em>{e.destaqueTitulo[1]}</em></h2>
      <p>{e.destaqueTexto}</p>
      <RegistrosAmsterdam idioma={idioma} />
      <dl class="ficha">
        <div>
          <dt class="rotulo destaque">{e.timeRotulo}</dt>
          <dd>{e.time}</dd>
        </div>
        <div>
          <dt class="rotulo destaque">{e.papelRotulo}</dt>
          <dd>{e.papel}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="outros">
    <div class="cabeca-secao">
      <p class="rotulo destaque">{e.outrosRotulo}</p>
      <h2 id="outros">{e.outrosTitulo}</h2>
    </div>
    <div class="grade grade-larga">
      {
        e.outros.map((o) => (
          <article class="celula">
            <p class="apoio rotulo">{o.rotulo}</p>
            <h3 class="projeto">{o.titulo}</h3>
            <p>{o.texto}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="indicadores">
    <div class="cabeca-secao">
      <p class="rotulo">

        {' '}{e.indicadoresRotulo}
      </p>
      <h2 id="indicadores">{e.indicadoresTitulo}</h2>
    </div>
    <div class="grade grade-media">
      {
        e.indicadores.map((n) => (
          <div class="celula">
            <p class="numero">{n.valor}</p>
            <p>{n.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="resultados-academicos">
    <div class="cabeca-secao">
      <p class="rotulo destaque">{idioma === 'pt' ? 'Gestão e qualidade' : 'Management and quality'}</p>
      <h2 id="resultados-academicos">{idioma === 'pt' ? 'Resultados acadêmicos' : 'Academic results'}</h2>
    </div>
    <div class="indicadores-academicos grade" aria-label={idioma === 'pt' ? 'Indicadores da universidade e do curso' : 'University and program indicators'}>
      <div class="celula"><p class="indicador-valor">IGC 5</p><p>{idioma === 'pt' ? 'Nota máxima da Universidade SENAI CIMATEC no Índice Geral de Cursos.' : 'SENAI CIMATEC University’s top score in Brazil’s General Course Index.'}</p></div>
      <div class="celula"><p class="indicador-valor">CPC 5</p><p>{idioma === 'pt' ? 'Nota máxima de Engenharia de Computação no Conceito Preliminar de Curso.' : 'Computer Engineering’s top score in Brazil’s Preliminary Course Score.'}</p></div>
      <div class="celula"><p class="indicador-valor">{idioma === 'pt' ? '4º do Brasil' : '4th in Brazil'}</p><p>{idioma === 'pt' ? 'Engenharia de Computação: 4º melhor curso do Brasil e melhor do Norte e Nordeste, segundo dados do MEC publicados em 2025, com base no CPC.' : 'Computer Engineering: 4th in Brazil and first in the North and Northeast, according to MEC data published in 2025, based on the CPC.'}</p></div>
    </div>
  </section>
</Base>

<style>
  .indicadores-academicos { grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); }
  .indicador-valor { font-size: clamp(30px, 4vw, 46px); line-height: 1.15; color: var(--azul-claro); }
  .abre {
    gap: 24px;
    max-width: 960px;
  }

  .resultado {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    align-items: start;
  }

  .ficha {
    margin: 0;
    padding: 14px 0;
    border-top: 1px solid var(--fio);
    border-bottom: 1px solid var(--fio);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ficha dd {
    margin: 0;
  }

  .projeto {
    font-size: 28px;
    line-height: 1.12;
  }

  .grade-media {
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }

  .numero {
    font-size: 56px;
    line-height: 1;
    font-weight: 500;
  }
</style>
