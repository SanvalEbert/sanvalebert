---
// Marca oficial Sanval Ebert (opção 1, monograma SE), usando os arquivos de produção em public/brand/.
// Os SVGs vêm prontos, com letras em contorno, e mantêm exatamente a distribuição do símbolo, do nome e do descritor.
// Não redesenhar aqui: para mudar a marca, troque os arquivos em public/brand/.
// No celular estreito, o cabeçalho usa a versão compacta (sem descritor), como recomenda o guia da marca.
import { endereco } from '../data/site';

interface Props {
  /** Texto alternativo (nome e descritor no idioma da página). */
  alt: string;
  /** Troca pela versão compacta em telas estreitas. */
  compactoNoCelular?: boolean;
  /** Carrega a imagem com prioridade (cabeçalho). */
  prioridade?: boolean;
}
const { alt, compactoNoCelular = false, prioridade = false } = Astro.props;
---

<picture class="logo">
  {compactoNoCelular && <source media="(max-width: 480px)" srcset={endereco('brand/logo-horizontal-compacto-escuro.svg')} width="720" height="140" />}
  <img
    src={endereco('brand/logo-horizontal-escuro.svg')}
    alt={alt}
    width="720"
    height="160"
    decoding="async"
    fetchpriority={prioridade ? 'high' : undefined}
    loading={prioridade ? undefined : 'lazy'}
  />
</picture>

<style>
  .logo { display: block; line-height: 0; }
  .logo img { display: block; height: 1em; width: auto; max-width: 100%; }
</style>
