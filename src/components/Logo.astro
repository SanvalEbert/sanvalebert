---
// Logo "Arco de luz": uma ponte que sai do azul (tecnologia) e chega ao ciano (educação),
// com pilares nas pontas e um ponto de encontro no topo. Ao lado, o nome e o descritor.
// O símbolo é SVG; o nome é texto, para ficar nítido e ser lido por leitores de tela.
// O tamanho segue o font-size do elemento pai (1em = altura de referência do nome).
interface Props {
  /** Mostra o descritor abaixo do nome. */
  descritor?: string;
}
const { descritor } = Astro.props;
const id = `arco-${Math.random().toString(36).slice(2, 8)}`;
---

<span class="logo">
  <svg class="simbolo" viewBox="0 0 72 48" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#2f62ff" />
        <stop offset="1" stop-color="#82e8f2" />
      </linearGradient>
    </defs>
    <path d="M8 40 C8 6, 64 6, 64 40" fill="none" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" />
    <circle cx="8" cy="40" r="5" fill="#2f62ff" />
    <circle cx="64" cy="40" r="5" fill="#82e8f2" />
    <circle cx="36" cy="14.6" r="4.2" fill="#f2f4f8" />
  </svg>
  <span class="texto">
    <span class="nome">Sanval <span class="sobrenome">Ebert</span></span>
    {descritor && <span class="descricao">{descritor}</span>}
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .5em; line-height: 1; }
  .simbolo { width: 2.05em; height: auto; flex: none; overflow: visible; }
  .texto { display: flex; flex-direction: column; gap: .3em; }
  .nome { font-family: var(--sans); font-size: 1em; font-weight: 750; letter-spacing: -.035em; color: var(--papel); white-space: nowrap; }
  .sobrenome { font-weight: 300; color: var(--ciano); }
  .descricao { font-family: var(--mono); font-size: max(.34em, 10px); letter-spacing: .16em; text-transform: uppercase; color: var(--nevoa); white-space: nowrap; }
</style>
