---
/** Interações decorativas: o conteúdo permanece disponível sem JavaScript. */
---
<script>
  const movimento = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ponteiro = window.matchMedia('(hover: hover) and (pointer: fine)');
  let observador: IntersectionObserver | undefined;
  let quadro = 0;
  const hero = document.querySelector<HTMLElement>('.abre');
  function iluminar(evento: PointerEvent) {
    if (!hero || movimento.matches || !ponteiro.matches) return;
    cancelAnimationFrame(quadro);
    const {clientX, clientY} = evento;
    quadro = requestAnimationFrame(() => {
      const area = hero.getBoundingClientRect();
      hero.style.setProperty('--luz-x', ((clientX-area.left)/area.width*100).toFixed(1)+'%');
      hero.style.setProperty('--luz-y', ((clientY-area.top)/area.height*100).toFixed(1)+'%');
    });
  }
  function restaurar() {
    cancelAnimationFrame(quadro);
    hero?.style.removeProperty('--luz-x');
    hero?.style.removeProperty('--luz-y');
  }
  function prepararEntradas() {
    observador?.disconnect();
    document.querySelectorAll('[data-entrada]').forEach(el => el.removeAttribute('data-entrada'));
    if (movimento.matches || !('IntersectionObserver' in window)) return;
    observador = new IntersectionObserver((entradas) => {
      for (const entrada of entradas) {
        if (entrada.isIntersecting) {
          entrada.target.setAttribute('data-entrada','ativa');
          observador?.unobserve(entrada.target);
        }
      }
    }, {threshold:.08});
    document.querySelectorAll('main > section').forEach(el => observador?.observe(el));
  }
  hero?.addEventListener('pointermove', iluminar, {passive:true});
  hero?.addEventListener('pointerleave', restaurar);
  movimento.addEventListener('change', () => { restaurar(); prepararEntradas(); });
  prepararEntradas();
  window.addEventListener('pagehide', () => {
    observador?.disconnect();
    cancelAnimationFrame(quadro);
  }, {once:true});
</script>
