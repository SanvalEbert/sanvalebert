---
// Cabeçalho em uma linha: marca à esquerda, menu no centro e idiomas à direita.
// Ao rolar, a barra fica mais baixa e a marca encolhe, sempre visível à esquerda.
// No celular: marca e idiomas na primeira linha, menu na segunda.
// A barra é fixa; o elemento header reserva a altura inicial, para o conteúdo não pular.
import { codigoHtml, endereco, idiomas, link, menu, nomeIdioma, paginas, type Idioma, type Pagina } from '../data/site';
import { tr } from '../i18n/tr';
import { t } from '../i18n/textos';
import Logo from './Logo.astro';
interface Props { idioma: Idioma; pagina: Pagina }
const { idioma, pagina } = Astro.props;
const txt = t(idioma);
const visiveis = menu.filter(item => paginas[item].pronta || item === 'sobre' || item === 'servicos');
---
<header class="portal-header" data-cabecalho>
 <div class="barra">
  <div class="conteudo linha">
   <a class="identidade" href={link('inicio', idioma)} title={tr(idioma, { pt: 'Ir para o início', en: 'Go to home', es: 'Ir al inicio' })}>
    <Logo descritor={tr(idioma, { pt: 'Educação, pesquisa e tecnologia', en: 'Education, research and technology', es: 'Educación, investigación y tecnología' })} />
   </a>
   <nav class="menu" aria-label={txt.site.menuPrincipal}>
    {visiveis.map(item => item === 'servicos'
      ? <span class="item-indisponivel" role="link" aria-disabled="true" title={txt.site.emBreve}>{txt.menu[item]}</span>
      : <a href={link(item, idioma)} aria-current={item === pagina ? 'page' : undefined}>{txt.menu[item]}</a>
    )}
   </nav>
   <nav class="idiomas" aria-label={tr(idioma, { pt: 'Idioma', en: 'Language', es: 'Idioma' })}>
    <svg class="globo" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
    {idiomas.map((i) => i === idioma
      ? <span class="ativo" aria-current="true" title={nomeIdioma[i]}><span class="so-leitor">{nomeIdioma[i]}</span><span aria-hidden="true">{i.toUpperCase()}</span></span>
      : <a href={endereco(paginas[pagina].rota[i])} lang={codigoHtml[i]} hreflang={codigoHtml[i]} title={nomeIdioma[i]}><span class="so-leitor">{nomeIdioma[i]}</span><span aria-hidden="true">{i.toUpperCase()}</span></a>
    )}
   </nav>
  </div>
 </div>
</header>

<script>
  const cabecalho = document.querySelector<HTMLElement>('[data-cabecalho]');
  if (cabecalho) {
    const encolher = 120; // pixels de rolagem até a barra chegar ao tamanho compacto
    let agendado = false;
    const atualizar = () => {
      agendado = false;
      const y = window.scrollY;
      cabecalho.style.setProperty('--p', String(Math.min(1, Math.max(0, y / encolher))));
      cabecalho.classList.toggle('rolado', y > 4);
    };
    const agendar = () => { if (!agendado) { agendado = true; requestAnimationFrame(atualizar); } };
    atualizar();
    window.addEventListener('scroll', agendar, { passive: true });
  }
</script>

<style>
.portal-header { --alto-max: 92px; --alto-min: 66px; --p: 0; height: var(--alto-max); position: relative; z-index: 20; }
.barra { position: fixed; inset: 0 0 auto; background: #060d1b; border-bottom: 1px solid var(--fio); transition: box-shadow .3s ease; }
.rolado .barra { box-shadow: 0 10px 30px rgba(0, 0, 0, .28); }
.barra::after { content: ""; position: absolute; bottom: -1px; left: 20%; right: 20%; height: 1px; background: linear-gradient(90deg, transparent, rgba(130, 232, 242, .65), transparent); pointer-events: none; }
.linha {
  height: calc(var(--alto-max) - (var(--alto-max) - var(--alto-min)) * var(--p));
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 24px;
}
.identidade { justify-self: start; font-size: 27px; text-decoration: none; transform: scale(calc(1 - var(--p) * .16)); transform-origin: left center; border-radius: 10px; padding: 4px 6px 4px 0; }
.identidade:hover { color: inherit; }
.identidade:hover :global(.letra-e) { fill: #5ee0e8; }
.menu { display: flex; gap: 4px 30px; }
.menu a, .menu .item-indisponivel { font-family: var(--mono); font-size: 12px; padding: 14px 0; text-decoration: none; border-bottom: 2px solid transparent; white-space: nowrap; }
.menu .item-indisponivel { color: var(--nevoa); opacity: .58; cursor: not-allowed; user-select: none; }
.menu a:hover { color: var(--ciano); }
.menu a[aria-current='page'] { color: var(--ciano); border-bottom-color: var(--ciano); }
.idiomas { justify-self: end; display: flex; align-items: center; gap: 2px; font-family: var(--mono); font-size: 12px; }
.globo { color: var(--nevoa); margin-right: 6px; }
.idiomas a, .idiomas .ativo { display: inline-grid; place-items: center; min-width: 32px; min-height: 32px; padding: 0 6px; border-radius: 8px; text-decoration: none; letter-spacing: .04em; }
.idiomas a { color: var(--nevoa); }
.idiomas a:hover { color: var(--papel); background: rgba(36, 82, 223, .25); }
.idiomas .ativo { color: var(--ciano); background: rgba(130, 232, 242, .1); box-shadow: inset 0 0 0 1px rgba(130, 232, 242, .4); }
.so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
@media (max-width: 1080px) {
  .identidade :global(.descricao) { display: none; }
  .menu { gap: 4px 22px; }
}
@media (max-width: 760px) {
  .portal-header { --alto-max: 116px; --alto-min: 104px; }
  .linha { grid-template-columns: 1fr auto; grid-template-areas: "marca idiomas" "menu menu"; row-gap: 0; align-content: center; }
  .identidade { grid-area: marca; font-size: 24px; }
  .idiomas { grid-area: idiomas; }
  .menu { grid-area: menu; gap: 0 18px; overflow-x: auto; scrollbar-width: none; border-top: 1px solid rgba(139, 188, 255, .12); }
  .menu::-webkit-scrollbar { display: none; }
  .menu a { font-size: 11px; padding: 12px 0; }
  /* Item desativado (em breve) fica oculto no celular para o menu caber inteiro. */
  .menu .item-indisponivel { display: none; }
  .globo { display: none; }
  .idiomas a, .idiomas .ativo { min-width: 28px; padding: 0 4px; font-size: 11px; }
}
@media (prefers-reduced-motion: reduce) { .identidade, .barra { transition: none; } }
</style>
