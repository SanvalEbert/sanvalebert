---
import { codigoHtml, endereco, link, menu, paginas, type Idioma, type Pagina } from '../data/site';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
  pagina: Pagina;
}

const { idioma, pagina } = Astro.props;
const txt = t(idioma);
const outro: Idioma = idioma === 'pt' ? 'en' : 'pt';
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<header class="conteudo cabecalho">
  <div class="faixa rotulo">
    <span>{txt.site.edicao}</span>
    <span class="local">{txt.site.local}</span>
    <span class="acoes">
      <a
        class="idioma"
        href={endereco(paginas[pagina].rota[outro])}
        lang={codigoHtml[outro]}
        hreflang={codigoHtml[outro]}
        title={txt.site.outroIdiomaAviso}>{txt.site.outroIdioma}</a
      >
      <a class="contratar" href={link('contratar', idioma)}>{txt.site.contratar} →</a>
    </span>
  </div>

  <div class="titulo">
    <a class="marca" href={link('inicio', idioma)}>Sanval <em>Ebert</em></a>
    <span class="rotulo">{txt.site.assinatura}</span>
  </div>

  <nav class="menu rotulo" aria-label={txt.site.menuPrincipal}>
    {
      menu.map((item, i) =>
        paginas[item].pronta ? (
          <a href={link(item, idioma)} aria-current={item === pagina ? 'page' : undefined}>
            {numero(i)} {txt.menu[item]}
          </a>
        ) : (
          <span class="inativo" title={txt.site.emBreve}>
            {numero(i)} {txt.menu[item]}
          </span>
        ),
      )
    }
  </nav>
</header>

<style>
  .cabecalho {
    padding-top: 16px;
  }

  .faixa {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 24px;
  }

  .acoes {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .faixa a {
    text-decoration: none;
    padding: 14px 0;
    display: inline-block;
  }

  .idioma {
    border: 1px solid var(--papel);
    padding: 8px 12px !important;
  }

  .idioma:hover {
    border-color: var(--azul-claro);
  }

  .contratar {
    color: var(--azul-claro);
    font-weight: 500;
  }

  .titulo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
    border-top: 3px solid var(--azul);
    border-bottom: 1px solid var(--papel);
    padding: 12px 0 8px;
    margin-top: 4px;
  }

  .marca {
    text-decoration: none;
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .marca:hover {
    color: var(--papel);
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    border-bottom: 1px solid var(--papel);
  }

  .menu a,
  .menu span {
    padding: 14px 0;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }

  .menu a[aria-current='page'] {
    color: var(--azul-claro);
    border-bottom-color: var(--azul);
  }

  .inativo {
    color: var(--nevoa);
  }

  @media (max-width: 540px) {
    .local {
      display: none;
    }
  }
</style>
