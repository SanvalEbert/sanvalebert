---
import { codigoHtml, endereco, link, menu, paginas, type Idioma, type Pagina } from '../data/site';
import { t } from '../i18n/textos';
interface Props { idioma: Idioma; pagina: Pagina }
const { idioma, pagina } = Astro.props;
const txt = t(idioma);
const outro: Idioma = idioma === 'pt' ? 'en' : 'pt';
const visiveis = menu.filter(item => paginas[item].pronta || item === 'sobre');
---
<header class="portal-header">
 <div class="conteudo estrutura">
  <a class="identidade" href={link('inicio', idioma)} title={idioma === 'pt' ? 'Ir para o início' : 'Go to home'}>
   <span class="marca"><span class="nome">Sanval <em>Ebert</em></span><span class="descricao">{idioma === 'pt' ? 'Educação, pesquisa e tecnologia' : 'Education, research and technology'}</span></span>
  </a>
  <nav class="menu" aria-label={txt.site.menuPrincipal}>
   {visiveis.map(item => <a href={link(item, idioma)} aria-current={item === pagina ? 'page' : undefined}>{txt.menu[item]}</a>)}
  </nav>
  <div class="acoes">
   <a class="idioma" href={endereco(paginas[pagina].rota[outro])} lang={codigoHtml[outro]} hreflang={codigoHtml[outro]} title={txt.site.outroIdiomaAviso}>{txt.site.outroIdioma}</a>
   <a class="contratar" href={link('contratar', idioma)} aria-current={pagina === 'contratar' ? 'page' : undefined}>{txt.site.contratar}<span aria-hidden="true"> ↗</span></a>
  </div>
 </div>
</header>
<style>
.portal-header{border-bottom:1px solid var(--fio);background:rgba(5,12,25,.8);backdrop-filter:blur(18px)}
.portal-header::after{content:"";position:absolute;bottom:-1px;left:20%;right:20%;height:1px;background:linear-gradient(90deg,transparent,rgba(130,232,242,.65),transparent);pointer-events:none}
.estrutura{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px 24px;padding-top:24px;padding-bottom:24px}
.identidade{display:inline-flex;align-items:center;text-decoration:none;flex-shrink:0}
.identidade:hover .nome em{color:#a5f4fb}
.marca{display:flex;flex-direction:column;gap:5px}
.nome{font-size:clamp(30px,2.35vw,35px);font-weight:750;line-height:1.05;letter-spacing:-.035em;white-space:nowrap}
.descricao{font-family:var(--mono);font-size:11px;line-height:1.5;color:var(--nevoa);letter-spacing:.005em}
.menu{display:flex;flex-wrap:wrap;gap:4px 22px}.menu a{font-family:var(--mono);font-size:12px;padding:12px 0;text-decoration:none;border-bottom:2px solid transparent}
.menu a[aria-current='page']{color:var(--ciano);border-bottom-color:var(--ciano);text-shadow:0 0 18px rgba(130,232,242,.2)}
.acoes{display:flex;align-items:center;gap:18px}.acoes a{font-family:var(--mono);font-size:12px;text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
.contratar{border:1px solid rgba(139,188,255,.4);border-radius:10px;box-shadow:0 5px 22px rgba(36,82,223,.2);background:var(--azul);padding:10px 16px;gap:8px;color:white}.contratar:hover{background:#2a5bf0;color:white}
@media(max-width:1100px){.menu{order:3;flex-basis:100%}}
@media(max-width:540px){.estrutura{gap:16px;padding-top:20px;padding-bottom:12px}.nome{font-size:30px}.descricao{font-size:10px}.acoes{gap:12px}.acoes a{font-size:11px}.contratar{padding:8px 12px}.menu{gap:4px 20px}}
@media(max-width:380px){.acoes{flex-basis:100%;justify-content:space-between}}
</style>
