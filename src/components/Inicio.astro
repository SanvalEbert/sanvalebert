---
// Página inicial, compartilhada pelas versões em português e em inglês.
import Base from '../layouts/Base.astro';
import { endereco, link, paginas, type Idioma, type Pagina } from '../data/site';
import RegistrosAmsterdam from './RegistrosAmsterdam.astro';
import Perfis from './Perfis.astro';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const txt = t(idioma);
const i = txt.inicio;
const pronta = (p: string) => paginas[p as Pagina].pronta;
const para = (p: string) => link(p as Pagina, idioma);
const contato = link('contratar', idioma);
const sobre = idioma === 'pt' ? {
  titulo: 'Sobre mim',
  apresentacao: 'Sou docente e pesquisador. Conecto educação e tecnologia para apoiar quem ensina e ampliar as possibilidades de aprendizagem.',
  atuacao: 'Na Universidade SENAI CIMATEC, coordeno os cursos de Engenharia de Computação e de Ciência de Dados e Inteligência Artificial. Meus estudos transitam entre inteligência artificial, tecnologias emergentes e educação.',
  perfis: 'Acompanhe meu trabalho',
} : {
  titulo: 'About me',
  apresentacao: 'I am an educator and researcher. I connect education and technology to support teachers and expand opportunities for learning.',
  atuacao: 'At SENAI CIMATEC University, I coordinate the Computer Engineering and Data Science and Artificial Intelligence programs. My studies span artificial intelligence, emerging technologies and education.',
  perfis: 'Follow my work',
};
---

<Base idioma={idioma} pagina="inicio" titulo={i.titulo} descricao={i.descricao}>
  <section class="conteudo secao abre">
    <div class="coluna texto">
      <h1>{i.chamada[0]} <em>{i.chamada[1]}</em></h1>
      <p class="abertura">{i.resumo}</p>
      <div class="linha">
        <a class="botao" href={contato}>{i.botaoPalestra}</a>
        {pronta('sobre') && <a class="italico" href={para('sobre')}>{i.verTrajetoria}</a>}
      </div>
    </div>
    <figure class="figura foto">
      <img class="retrato" src={endereco('images/sanval-ebert.png')} width="322" height="357" alt={idioma === 'pt' ? 'Retrato de Sanval Ebert, com óculos e blazer preto' : 'Portrait of Sanval Ebert wearing glasses and a black blazer'} fetchpriority="high" />
      <figcaption>{i.fig1}</figcaption>
    </figure>
  </section>

  <section id="sobre" class="conteudo secao sobre" aria-labelledby="sobre-titulo">
    <div class="cabeca-secao"><h2 id="sobre-titulo">{sobre.titulo}</h2></div>
    <div class="sobre-grade">
      <div class="coluna"><p class="abertura">{sobre.apresentacao}</p><p>{sobre.atuacao}</p></div>
      <div class="coluna"><h3>{sobre.perfis}</h3><Perfis principais /></div>
    </div>
    <div class="indicadores-sobre grade" aria-label={idioma === 'pt' ? 'Indicadores da universidade e do curso' : 'University and program indicators'}>
      <div class="celula"><p class="indicador-valor">IGC 5</p><p>{idioma === 'pt' ? 'Nota máxima da Universidade SENAI CIMATEC no Índice Geral de Cursos.' : 'SENAI CIMATEC University’s top score in Brazil’s General Course Index.'}</p></div>
      <div class="celula"><p class="indicador-valor">CPC 5</p><p>{idioma === 'pt' ? 'Nota máxima de Engenharia de Computação no Conceito Preliminar de Curso.' : 'Computer Engineering’s top score in Brazil’s Preliminary Course Score.'}</p></div>
      <div class="celula"><p class="indicador-valor">{idioma === 'pt' ? '4º do Brasil' : '4th in Brazil'}</p><p>{idioma === 'pt' ? 'Engenharia de Computação, também destaque como o melhor curso do Norte e Nordeste, segundo divulgação da universidade em 2025.' : 'Computer Engineering, also ranked first in the North and Northeast, according to the university’s 2025 announcement.'}</p></div>
    </div>
    <p class="apoio fonte-indicadores"><a href="https://www.universidadesenaicimatec.edu.br/universidade-senai-cimatec-esta-entre-as-melhores-do-brasil-segundo-avaliacao-do-mec/">{idioma === 'pt' ? 'Conheça os resultados da Universidade SENAI CIMATEC — divulgação de 14/04/2025' : 'Explore SENAI CIMATEC University’s results — announcement of 14 April 2025'}</a></p>
  </section>

  <section class="conteudo secao destaque-recente" aria-labelledby="destaque">
    <figure class="figura">
      <img class="foto-evento" src={endereco('images/engage-agent-amsterdam-2026.jpg')} width="1399" height="933" alt={idioma === 'pt' ? 'Premiação do Engage-Agent com o cheque de segundo lugar e as bandeiras do Brasil e do SENAI CIMATEC' : 'Engage-Agent award ceremony with the second-place cheque and the Brazilian and SENAI CIMATEC flags'} loading="lazy" decoding="async" />
      <figcaption>{i.fig2}</figcaption>
    </figure>
    <div class="coluna">
      <p class="rotulo destaque">{i.destaqueRotulo}</p>
      <h2 id="destaque">{i.destaqueTitulo[0]} <em>{i.destaqueTitulo[1]}</em></h2>
      <p>{i.destaqueTexto}</p>
      <RegistrosAmsterdam idioma={idioma} />

    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="palestras">
    <div class="cabeca-secao">
      <p class="rotulo destaque">{i.palestrasRotulo}</p>
      <h2 id="palestras">{i.palestrasTitulo}</h2>
    </div>
    <div class="grade">
      {
        i.palestras.map((p) => (
          <div class="celula">
            <p class="apoio rotulo">{p.publico}</p>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        ))
      }
    </div>
    <div class="linha depois">
      <a class="botao" href={contato}>{i.palestrasBotao}</a>
      {
        pronta('palestras') && (
          <a class="italico" href={para('palestras')}>
            {i.palestrasElo}
          </a>
        )
      }
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="curso">
    <div class="bloco-azul coluna">
      <p class="rotulo">{i.cursoRotulo}</p>
      <h2 id="curso">{i.cursoTitulo[0]} <i>{i.cursoTitulo[1]}</i></h2>
      <p class="curso-texto">{i.cursoTexto}</p>
      <div><a class="botao botao-noite" href={contato}>{i.cursoBotao}</a></div>
    </div>
  </section>
</Base>

<style>
  .abre {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 40px;
  }

  .texto {
    flex: 999 1 480px;
    min-width: 0;
    gap: 24px;
  }

  .foto {
    flex: 1 1 280px;
    max-width: 322px;
  }

  .retrato { display: block; width: 100%; height: auto; }

  .indicadores-sobre { margin-top: 32px; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); }
  .indicador-valor { font-size: clamp(30px, 4vw, 46px); line-height: 1.15; color: var(--azul-claro); }
  .fonte-indicadores { margin-top: 20px; }
  .sobre-grade { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px; }
  @media (max-width: 760px) { .sobre-grade { grid-template-columns: 1fr; } }

  .destaque-recente {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    align-items: start;
  }

  .depois {
    margin-top: 28px;
  }

  .curso-texto {
    max-width: 40em;
  }

  .bloco-azul i {
    font-weight: 400;
  }
</style>
