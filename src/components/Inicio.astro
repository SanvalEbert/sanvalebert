---
// Página inicial, compartilhada pelas versões em português e em inglês.
import Base from '../layouts/Base.astro';
import { endereco, link, paginas, type Idioma, type Pagina } from '../data/site';
import { destaques } from '../data/destaques';
import { categorias, noticias } from '../data/noticias';
import Carrossel from './Carrossel.astro';
import Perfis from './Perfis.astro';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const txt = t(idioma);
const i = txt.inicio;
const pt = idioma === 'pt';
const pronta = (p: string) => paginas[p as Pagina].pronta;
const para = (p: string) => link(p as Pagina, idioma);
const dataCurta = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString(pt ? 'pt-BR' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const sobre = pt ? {
  titulo: 'Sobre mim',
  apresentacao: 'Sou docente e pesquisador. Conecto educação e tecnologia para apoiar quem ensina e ampliar as possibilidades de aprendizagem.',
  atuacao: 'Na Universidade SENAI CIMATEC, coordeno os cursos de Engenharia de Computação e de Ciência de Dados e Inteligência Artificial. Meus estudos transitam entre inteligência artificial, tecnologias emergentes e educação.',
  perfis: 'Acompanhe meu trabalho',
} : {
  titulo: 'About me',
  apresentacao: 'I am an educator and researcher. I connect education and technology to support teachers and expand opportunities for learning.',
  atuacao: 'At SENAI CIMATEC University, I coordinate the Computer Engineering and Data Science and Artificial Intelligence programs. My studies span artificial intelligence, emerging technologies and education.',
  perfis: 'Follow my work',
};
---

<Base idioma={idioma} pagina="inicio" titulo={i.titulo} descricao={i.descricao}>
  <section class="conteudo secao abre">
    <div class="coluna texto">
      <h1>{i.chamada[0]} <em>{i.chamada[1]}</em></h1>
      <p class="abertura">{i.resumo}</p>
      {pronta('sobre') && <div class="linha"><a class="italico" href={para('sobre')}>{i.verTrajetoria}</a></div>}
    </div>
    <figure class="figura foto">
      <img class="retrato" src={endereco('images/sanval-ebert.png')} width="322" height="357" alt={pt ? 'Retrato de Sanval Ebert, com óculos e blazer preto' : 'Portrait of Sanval Ebert wearing glasses and a black blazer'} fetchpriority="high" />
      <figcaption class="perfil-profissional">{i.credenciais.join(' | ')}</figcaption>
    </figure>
  </section>

  <section id="sobre" class="conteudo secao sobre" aria-labelledby="sobre-titulo">
    <div class="cabeca-secao"><h2 id="sobre-titulo">{sobre.titulo}</h2></div>
    <div class="sobre-grade">
      <div class="coluna"><p class="abertura">{sobre.apresentacao}</p><p>{sobre.atuacao}</p></div>
      <div class="coluna"><h3>{sobre.perfis}</h3><Perfis principais /></div>
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="destaques">
    <div class="cabeca-secao">
      <p class="rotulo destaque">{i.destaquesRotulo}</p>
      <h2 id="destaques">{i.destaquesTitulo}</h2>
    </div>
    <Carrossel idioma={idioma} rotulo={i.destaquesRotulo} automatico={7000}>
      {destaques.map((d, n) => (
        <li class="slide-destaque" aria-roledescription={pt ? 'item' : 'slide'} aria-label={`${n + 1} / ${destaques.length}`}>
          <figure class="figura">
            {d.imagem
              ? <img class="foto-evento" src={endereco(d.imagem.arquivo)} width={d.imagem.largura} height={d.imagem.altura} alt={d.imagem.alt[idioma]} loading={n === 0 ? 'eager' : 'lazy'} decoding="async" />
              : <div class="espaco-foto sem-foto" aria-hidden="true">{txt.site.fotoEmBreve}</div>}
            {d.legenda && <figcaption>{d.legenda[idioma]}</figcaption>}
          </figure>
          <div class="coluna">
            <p class="rotulo destaque">{d.quando[idioma]}</p>
            <h3 class="titulo-destaque">{d.titulo[idioma]}</h3>
            <p>{d.texto[idioma]}</p>
            <div class="linha links">
              {d.links.map((l) => <a class="italico" href={l.url} rel="noopener">{l.rotulo[idioma]}<span class="so-leitor">: {d.titulo[idioma]}</span> <span aria-hidden="true">↗</span></a>)}
            </div>
          </div>
        </li>
      ))}
    </Carrossel>
  </section>

  {noticias.length > 0 && (
    <section class="conteudo secao" aria-labelledby="noticias">
      <div class="cabeca-secao">
        <p class="rotulo destaque">{i.noticiasRotulo}</p>
        <h2 id="noticias">{i.noticiasTitulo}</h2>
        <p class="apoio nota">{i.noticiasTexto}</p>
      </div>
      <ul class="recomendacoes">
        {noticias.map((n) => (
          <li class="recomendacao">
            <article class="cartao" aria-labelledby={`rec-${n.url.replace(/\W+/g, '-')}`}>
              <div class="cartao-topo">
                <span class="selo" aria-hidden="true">{n.fonte.split(' ').map((p) => p[0]).join('').slice(0, 3)}</span>
                <span class="apoio">{n.fonte}</span>
              </div>
              <p class="rotulo destaque">{categorias[n.categoria][idioma]}</p>
              <h3 id={`rec-${n.url.replace(/\W+/g, '-')}`}>{n.titulo[idioma]}</h3>
              <p class="cartao-resumo">{n.resumo[idioma]}</p>
              {n.etiquetas && (
                <ul class="etiquetas" aria-label={pt ? 'Características' : 'Features'}>
                  {n.etiquetas.map((e) => <li>{e[idioma]}</li>)}
                </ul>
              )}
              {n.data && <p class="apoio"><time datetime={n.data}>{dataCurta(n.data)}</time></p>}
              <a class="botao acessar" href={n.url} rel="noopener" target="_blank">
                {i.noticiasElo}<span class="so-leitor"> {n.titulo[idioma]} ({pt ? 'abre em nova aba' : 'opens in a new tab'})</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .abre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    position: relative;
    isolation: isolate;
  }

  .abre::before { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:radial-gradient(ellipse at var(--luz-x, 78%) var(--luz-y, 42%), rgba(34,115,194,.2), transparent 65%); }
  .texto h1 { max-width: 14ch; }
  .texto {
    flex: 999 1 480px;
    min-width: 0;
    gap: 24px;
  }

  .foto {
    flex: 1 1 340px;
    max-width: 380px;
    padding: 12px;
    border: 1px solid rgba(130,232,242,.3);
    border-radius: 24px;
    background: linear-gradient(145deg,rgba(24,53,85,.8),rgba(7,17,31,.9));
    box-shadow: 0 24px 80px rgba(0,0,0,.35),0 0 64px rgba(32,105,198,.16),inset 0 1px 0 rgba(130,232,242,.1);
  }

  .retrato { display: block; width: 100%; height: auto; }
  .perfil-profissional { padding: 6px 2px 2px; line-height: 1.7; }

  .sobre-grade { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px; }
  @media (max-width: 760px) { .sobre-grade { grid-template-columns: 1fr; } }

  .slide-destaque {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    align-items: start;
  }
  .sem-foto { aspect-ratio: 3 / 2; border-radius: 16px; border-color: rgba(139,188,255,.3); }
  .titulo-destaque { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.15; }
  .links { gap: 4px 24px; }

  .nota { max-width: 40em; }

  .recomendacoes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 640px) { .recomendacoes { grid-template-columns: 1fr; } }
  .recomendacao { display: flex; }
  .cartao {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.4vw, 30px);
    border: 1px solid var(--fio);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(20, 40, 68, .95), rgba(9, 19, 35, .97));
    box-shadow: inset 0 1px 0 rgba(130, 232, 242, .12), 0 18px 40px rgba(0, 0, 0, .18);
    overflow: hidden;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .cartao::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--azul), var(--ciano));
    opacity: .8;
  }
  .cartao-topo { display: flex; align-items: center; gap: 12px; }
  .selo {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(36, 82, 223, .22);
    border: 1px solid rgba(139, 188, 255, .35);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--ciano);
    letter-spacing: .04em;
  }
  .cartao h3 { font-size: clamp(23px, 2vw, 27px); }
  .cartao-resumo { color: #d4dfed; font-size: 16px; line-height: 1.6; }
  .etiquetas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .etiquetas li {
    font-family: var(--mono);
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid rgba(130, 232, 242, .3);
    color: var(--nevoa);
  }
  .acessar { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; }
  @media (hover: hover) {
    .cartao:hover { transform: translateY(-4px); border-color: rgba(130, 232, 242, .45); box-shadow: inset 0 1px 0 rgba(130, 232, 242, .16), 0 24px 56px rgba(0, 0, 0, .28); }
  }
  .cartao:focus-within { border-color: rgba(130, 232, 242, .6); }

  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
