---
// Página inicial, compartilhada pelas versões em português e em inglês.
import Base from '../layouts/Base.astro';
import { endereco, link, paginas, type Idioma, type Pagina } from '../data/site';
import { destaques } from '../data/destaques';
import { categorias, noticias } from '../data/noticias';
import { universidade as uni } from '../data/universidade';
import Carrossel from './Carrossel.astro';
import Perfis from './Perfis.astro';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const txt = t(idioma);
const i = txt.inicio;
const pt = idioma === 'pt';
const pronta = (p: string) => paginas[p as Pagina].pronta;
const para = (p: string) => link(p as Pagina, idioma);
const dataCurta = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString(pt ? 'pt-BR' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const sobre = pt ? {
  titulo: 'Sobre mim',
  abertura: 'Conecto tecnologias emergentes a projetos educacionais que levam instituições, salas de aula e carreiras à transformação digital.',
  trajetoria: 'Sou professor, pesquisador e doutor em Difusão do Conhecimento. Na Universidade SENAI CIMATEC, coordeno os cursos de Engenharia de Computação e de Ciência de Dados e Inteligência Artificial e respondo pela coordenação técnica de programas de pós-graduação.',
  impacto: 'Desenvolvo produtos tecnológicos e educacionais que tiram a inovação do laboratório e a colocam em uso. Como mentor, acompanho equipes de estudantes da ideia ao pódio: em 2026, o Engage-Agent conquistou o 2º lugar mundial no HackaStone, em Amsterdã, e recebi o Mentor Award, um dos 19 concedidos no mundo.',
  frentesRotulo: 'Onde atuo',
  frentes: [
    { titulo: 'Gestão acadêmica', texto: 'Cursos de graduação e programas de pós-graduação conectados à indústria.' },
    { titulo: 'Pesquisa aplicada', texto: 'IA na educação, agentes inteligentes e tecnologias imersivas.' },
    { titulo: 'Produtos e inovação', texto: 'Soluções tecnológicas e educacionais, do conceito à adoção.' },
    { titulo: 'Mentoria', texto: 'Equipes premiadas em competições internacionais de inovação.' },
  ],
  perfis: 'Conheça meu trabalho',
  perfisTexto: 'Publicações, projetos, entrevistas e bastidores da sala de aula estão nos links a seguir.',
} : {
  titulo: 'About me',
  abertura: 'I connect emerging technologies to education projects that move institutions, classrooms and careers through digital transformation.',
  trajetoria: 'I am a professor, researcher and PhD in Knowledge Diffusion. At SENAI CIMATEC University, I coordinate the Computer Engineering and Data Science and Artificial Intelligence programs and lead the technical coordination of graduate programs.',
  impacto: 'I develop technology and education products that take innovation out of the lab and into use. As a mentor, I guide student teams from idea to podium: in 2026, Engage-Agent took 2nd place worldwide at HackaStone in Amsterdam, and I received the Mentor Award, one of 19 granted worldwide.',
  frentesRotulo: 'What I do',
  frentes: [
    { titulo: 'Academic leadership', texto: 'Undergraduate and graduate programs connected to industry.' },
    { titulo: 'Applied research', texto: 'AI in education, intelligent agents and immersive technologies.' },
    { titulo: 'Products and innovation', texto: 'Technology and education solutions, from concept to adoption.' },
    { titulo: 'Mentoring', texto: 'Award-winning teams in international innovation competitions.' },
  ],
  perfis: 'Get to know my work',
  perfisTexto: 'Publications, projects, interviews and behind-the-scenes from the classroom are in the links below.',
};
---

<Base idioma={idioma} pagina="inicio" titulo={i.titulo} descricao={i.descricao}>
  <section class="conteudo secao abre">
    <div class="coluna texto">
      <h1>{i.chamada[0]} <em>{i.chamada[1]}</em></h1>
      <p class="abertura">{i.resumo}</p>
      {pronta('sobre') && <div class="linha"><a class="italico" href={para('sobre')}>{i.verTrajetoria}</a></div>}
    </div>
    <figure class="figura foto">
      <img class="retrato" src={endereco('images/sanval-ebert.png')} width="322" height="357" alt={pt ? 'Retrato de Sanval Ebert, com óculos e blazer preto' : 'Portrait of Sanval Ebert wearing glasses and a black blazer'} fetchpriority="high" />
      <figcaption class="perfil-profissional">{i.credenciais.join(' | ')}</figcaption>
    </figure>
  </section>

  <section id="sobre" class="conteudo secao sobre" aria-labelledby="sobre-titulo">
    <div class="cabeca-secao"><h2 id="sobre-titulo">{sobre.titulo}</h2></div>
    <div class="sobre-grade">
      <div class="coluna">
        <p class="abertura sobre-abertura">{sobre.abertura}</p>
        <p>{sobre.trajetoria}</p>
        <p>{sobre.impacto}</p>
        <h3 class="rotulo destaque frentes-rotulo">{sobre.frentesRotulo}</h3>
        <ul class="frentes">
          {sobre.frentes.map((f) => <li><strong>{f.titulo}</strong><span>{f.texto}</span></li>)}
        </ul>
      </div>
      <aside class="coluna conheca" aria-labelledby="conheca-titulo">
        <h3 id="conheca-titulo">{sobre.perfis}</h3>
        <p class="apoio">{sobre.perfisTexto}</p>
        <Perfis />
      </aside>
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="destaques">
    <div class="cabeca-secao">
      <p class="rotulo destaque">{i.destaquesRotulo}</p>
      <h2 id="destaques">{i.destaquesTitulo}</h2>
    </div>
    <Carrossel idioma={idioma} rotulo={i.destaquesRotulo} automatico={7000}>
      {destaques.map((d, n) => (
        <li class="slide-destaque" aria-roledescription={pt ? 'item' : 'slide'} aria-label={`${n + 1} / ${destaques.length}`}>
          <figure class="figura">
            {d.imagem
              ? <img class="foto-evento" src={endereco(d.imagem.arquivo)} width={d.imagem.largura} height={d.imagem.altura} alt={d.imagem.alt[idioma]} loading={n === 0 ? 'eager' : 'lazy'} decoding="async" />
              : <div class="espaco-foto sem-foto" aria-hidden="true">{txt.site.fotoEmBreve}</div>}
            {d.legenda && <figcaption>{d.legenda[idioma]}</figcaption>}
          </figure>
          <div class="coluna">
            <p class="rotulo destaque">{d.quando[idioma]}</p>
            <h3 class="titulo-destaque">{d.titulo[idioma]}</h3>
            <p>{d.texto[idioma]}</p>
            <div class="linha links">
              {d.links.map((l) => <a class="italico" href={l.url} rel="noopener">{l.rotulo[idioma]}<span class="so-leitor">: {d.titulo[idioma]}</span> <span aria-hidden="true">↗</span></a>)}
            </div>
          </div>
        </li>
      ))}
    </Carrossel>
  </section>

  {noticias.length > 0 && (
    <section class="conteudo secao" aria-labelledby="noticias">
      <div class="cabeca-secao">
        <p class="rotulo destaque">{i.noticiasRotulo}</p>
        <h2 id="noticias">{i.noticiasTitulo}</h2>
        <p class="apoio nota">{i.noticiasTexto}</p>
      </div>
      <article class="universidade" aria-labelledby="uni-titulo">
        <div class="uni-intro">
          <div class="cartao-topo">
            <span class="selo selo-uni" aria-hidden="true">SC</span>
            <span class="apoio">{uni.nome}</span>
          </div>
          <p class="rotulo destaque">{uni.rotulo[idioma]}</p>
          <h3 id="uni-titulo">{uni.titulo[idioma]}</h3>
          <p class="cartao-resumo">{uni.resumo[idioma]}</p>
        </div>
        <div class="uni-cursos">
          <p class="apoio uni-nota">{uni.nota[idioma]}</p>
          <ul>
            {uni.cursos.map((c) => (
              <li>
                <a class="curso" href={c.url} rel="noopener" target="_blank">
                  <span class="curso-nome">{c.nome[idioma]}</span>
                  <span class="curso-dados"><span>{c.formato[idioma]}</span><span aria-hidden="true">·</span><span>{c.duracao[idioma]}</span></span>
                  <span class="curso-acao">{uni.botaoCurso[idioma]}<span class="so-leitor">: {c.nome[idioma]} ({pt ? 'abre em nova aba' : 'opens in a new tab'})</span> <span aria-hidden="true">↗</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="uni-outros">
          <p>{uni.outrosTitulo[idioma]}</p>
          <ul class="linha">
            {uni.outros.map((o) => (
              <li><a class="pilula" href={o.url} rel="noopener" target="_blank">{o.rotulo[idioma]}<span class="so-leitor"> — {uni.nome} ({pt ? 'abre em nova aba' : 'opens in a new tab'})</span> <span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </div>
      </article>

      <Carrossel idioma={idioma} rotulo={i.noticiasTitulo} modo="cartoes" automatico={6000}>
        {noticias.map((n) => (
          <li class="recomendacao">
            <article class="cartao" aria-labelledby={`rec-${n.url.replace(/\W+/g, '-')}`}>
              <div class="cartao-topo">
                <span class="selo" aria-hidden="true">{n.fonte.split(' ').map((p) => p[0]).join('').slice(0, 3)}</span>
                <span class="apoio">{n.fonte}</span>
              </div>
              <p class="rotulo destaque">{categorias[n.categoria][idioma]}</p>
              <h3 id={`rec-${n.url.replace(/\W+/g, '-')}`}>{n.titulo[idioma]}</h3>
              <p class="cartao-resumo">{n.resumo[idioma]}</p>
              {n.etiquetas && (
                <ul class="etiquetas" aria-label={pt ? 'Características' : 'Features'}>
                  {n.etiquetas.map((e) => <li>{e[idioma]}</li>)}
                </ul>
              )}
              {n.data && <p class="apoio"><time datetime={n.data}>{dataCurta(n.data)}</time></p>}
              <a class="botao acessar" href={n.url} rel="noopener" target="_blank">
                {i.noticiasElo}<span class="so-leitor"> {n.titulo[idioma]} ({pt ? 'abre em nova aba' : 'opens in a new tab'})</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          </li>
        ))}
      </Carrossel>
    </section>
  )}
</Base>

<style>
  .abre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    position: relative;
    isolation: isolate;
  }

  .abre::before { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:radial-gradient(ellipse at var(--luz-x, 78%) var(--luz-y, 42%), rgba(34,115,194,.2), transparent 65%); }
  .texto h1 { max-width: 14ch; }
  .texto {
    flex: 999 1 480px;
    min-width: 0;
    gap: 24px;
  }

  .foto {
    flex: 1 1 340px;
    max-width: 380px;
    padding: 12px;
    border: 1px solid rgba(130,232,242,.3);
    border-radius: 24px;
    background: linear-gradient(145deg,rgba(24,53,85,.8),rgba(7,17,31,.9));
    box-shadow: 0 24px 80px rgba(0,0,0,.35),0 0 64px rgba(32,105,198,.16),inset 0 1px 0 rgba(130,232,242,.1);
  }

  .retrato { display: block; width: 100%; height: auto; }
  .perfil-profissional { padding: 6px 2px 2px; line-height: 1.7; }

  .sobre-grade { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px; }
  .sobre-abertura { font-size: clamp(21px, 2vw, 26px); line-height: 1.45; color: var(--papel); font-weight: 500; }
  .frentes-rotulo { margin-top: 12px; }
  .frentes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .frentes li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--fio);
    border-left: 3px solid var(--ciano);
    border-radius: 12px;
    background: rgba(12, 23, 41, .6);
  }
  .frentes strong { font-size: 17px; font-weight: 650; }
  .frentes span { font-size: 15px; line-height: 1.5; color: #d4dfed; }
  @media (max-width: 560px) { .frentes { grid-template-columns: 1fr; } }
  .conheca {
    align-self: start;
    padding: clamp(22px, 2.4vw, 30px);
    border: 1px solid rgba(130, 232, 242, .3);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(20, 40, 68, .9), rgba(9, 19, 35, .95));
  }
  @media (min-width: 761px) { .conheca { position: sticky; top: 24px; } }
  @media (max-width: 760px) { .sobre-grade { grid-template-columns: 1fr; } }

  .slide-destaque {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    align-items: start;
  }
  .sem-foto { aspect-ratio: 3 / 2; border-radius: 16px; border-color: rgba(139,188,255,.3); }
  .titulo-destaque { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.15; }
  .links { gap: 4px 24px; }

  .nota { max-width: 40em; }

  .recomendacao { display: flex; height: 100%; }
  .cartao {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.4vw, 30px);
    border: 1px solid var(--fio);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(20, 40, 68, .95), rgba(9, 19, 35, .97));
    box-shadow: inset 0 1px 0 rgba(130, 232, 242, .12), 0 18px 40px rgba(0, 0, 0, .18);
    overflow: hidden;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .cartao::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--azul), var(--ciano));
    opacity: .8;
  }
  .cartao-topo { display: flex; align-items: center; gap: 12px; }
  .selo {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(36, 82, 223, .22);
    border: 1px solid rgba(139, 188, 255, .35);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--ciano);
    letter-spacing: .04em;
  }
  .cartao h3 { font-size: clamp(23px, 2vw, 27px); }
  .cartao-resumo { color: #d4dfed; font-size: 16px; line-height: 1.6; }
  .etiquetas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .etiquetas li {
    font-family: var(--mono);
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid rgba(130, 232, 242, .3);
    color: var(--nevoa);
  }
  .acessar { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; }
  @media (hover: hover) {
    .cartao:hover { transform: translateY(-4px); border-color: rgba(130, 232, 242, .45); box-shadow: inset 0 1px 0 rgba(130, 232, 242, .16), 0 24px 56px rgba(0, 0, 0, .28); }
  }
  .cartao:focus-within { border-color: rgba(130, 232, 242, .6); }

  .universidade {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 28px clamp(28px, 4vw, 48px);
    margin-bottom: 24px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid rgba(130, 232, 242, .35);
    border-radius: 24px;
    background:
      radial-gradient(ellipse at 100% 0%, rgba(53, 163, 204, .22), transparent 60%),
      linear-gradient(135deg, #10234b, #0a172e);
    box-shadow: 0 20px 70px rgba(0, 0, 0, .22), inset 0 1px 0 rgba(130, 232, 242, .12);
    overflow: hidden;
  }
  .universidade::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--azul), var(--ciano));
  }
  .uni-intro { display: flex; flex-direction: column; gap: 14px; }
  .universidade h3 { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.15; }
  .selo-uni { background: rgba(130, 232, 242, .14); border-color: rgba(130, 232, 242, .5); }
  .uni-cursos { display: flex; flex-direction: column; gap: 12px; }
  .uni-nota { text-transform: uppercase; letter-spacing: .1em; font-size: 11px; }
  .uni-cursos ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .curso {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "nome acao" "dados acao";
    gap: 4px 16px;
    align-items: center;
    padding: 18px 20px;
    border: 1px solid rgba(139, 188, 255, .3);
    border-radius: 16px;
    background: rgba(6, 12, 24, .45);
    text-decoration: none;
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .curso-nome { grid-area: nome; font-size: 19px; font-weight: 650; line-height: 1.25; }
  .curso-dados { grid-area: dados; display: flex; gap: 8px; font-family: var(--mono); font-size: 12px; color: var(--nevoa); }
  .curso-acao { grid-area: acao; font-family: var(--mono); font-size: 12px; color: var(--ciano); white-space: nowrap; }
  .curso:hover { border-color: var(--ciano); background: rgba(18, 40, 74, .7); color: var(--papel); }
  .uni-outros {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 22px;
    border-top: 1px solid rgba(139, 188, 255, .2);
  }
  .uni-outros p { flex: 1 1 360px; color: #d4dfed; font-size: 16px; }
  .uni-outros ul { list-style: none; margin: 0; padding: 0; gap: 10px; }
  .pilula {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid rgba(130, 232, 242, .4);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    text-decoration: none;
    transition: border-color .2s ease, background .2s ease;
  }
  .pilula:hover { border-color: var(--ciano); background: rgba(36, 82, 223, .25); color: var(--papel); }
  @media (max-width: 860px) {
    .universidade { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .curso { grid-template-columns: 1fr; grid-template-areas: "nome" "dados" "acao"; }
    .curso-acao { margin-top: 6px; }
  }
  @media (hover: hover) { .curso:hover { transform: translateY(-2px); } }

  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
