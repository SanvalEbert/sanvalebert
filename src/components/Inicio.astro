---
import { tr } from '../i18n/tr';
// Página inicial, compartilhada pelas versões em português e em inglês.
import Base from '../layouts/Base.astro';
import { endereco, link, paginas, type Idioma, type Pagina } from '../data/site';
import { destaques } from '../data/destaques';
import { categorias, noticias } from '../data/noticias';
import { universidade as uni } from '../data/universidade';
import Carrossel from './Carrossel.astro';
import Perfis from './Perfis.astro';
import FotosAbertura from './FotosAbertura.astro';
import { t } from '../i18n/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const txt = t(idioma);
const i = txt.inicio;
const pronta = (p: string) => paginas[p as Pagina].pronta;
const para = (p: string) => link(p as Pagina, idioma);
const dataCurta = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString(tr(idioma, { pt: 'pt-BR', en: 'en-GB', es: 'es-ES' }), { day: 'numeric', month: 'short', year: 'numeric' });
const sobre = tr(idioma, {
  pt: {
  titulo: 'Sobre mim',
  abertura: 'Conecto tecnologias emergentes a projetos educacionais que levam instituições, salas de aula e carreiras à transformação digital.',
  trajetoria: 'Sou professor, pesquisador e doutor em Difusão do Conhecimento. Na Universidade SENAI CIMATEC, coordeno os cursos de Engenharia de Computação e de Ciência de Dados e Inteligência Artificial e respondo pela coordenação técnica de programas de pós-graduação.',
  impacto: 'Desenvolvo produtos tecnológicos e educacionais que tiram a inovação do laboratório e a colocam em uso. Como mentor, acompanho equipes de estudantes da ideia ao pódio: em 2026, o Engage-Agent conquistou o 2º lugar mundial no HackaStone, em Amsterdã, e recebi o Mentor Award, um dos 19 concedidos no mundo.',
  frentesRotulo: 'Onde atuo',
  frentes: [
    { titulo: 'Gestão acadêmica', texto: 'Cursos de graduação e programas de pós-graduação conectados à indústria.' },
    { titulo: 'Pesquisa aplicada', texto: 'IA na educação, agentes inteligentes e tecnologias imersivas.' },
    { titulo: 'Produtos e inovação', texto: 'Soluções tecnológicas e educacionais, do conceito à adoção.' },
    { titulo: 'Mentoria', texto: 'Equipes premiadas em competições internacionais de inovação.' },
  ],
  perfis: 'Conheça meu trabalho',
  perfisTexto: 'Publicações, projetos, entrevistas e bastidores da sala de aula estão nos links a seguir.',
},
  en: {
  titulo: 'About me',
  abertura: 'I connect emerging technologies to education projects that move institutions, classrooms and careers through digital transformation.',
  trajetoria: 'I am a professor, researcher and PhD in Knowledge Diffusion. At SENAI CIMATEC University, I coordinate the Computer Engineering and Data Science and Artificial Intelligence programs and lead the technical coordination of graduate programs.',
  impacto: 'I develop technology and education products that take innovation out of the lab and into use. As a mentor, I guide student teams from idea to podium: in 2026, Engage-Agent took 2nd place worldwide at HackaStone in Amsterdam, and I received the Mentor Award, one of 19 granted worldwide.',
  frentesRotulo: 'What I do',
  frentes: [
    { titulo: 'Academic leadership', texto: 'Undergraduate and graduate programs connected to industry.' },
    { titulo: 'Applied research', texto: 'AI in education, intelligent agents and immersive technologies.' },
    { titulo: 'Products and innovation', texto: 'Technology and education solutions, from concept to adoption.' },
    { titulo: 'Mentoring', texto: 'Award-winning teams in international innovation competitions.' },
  ],
  perfis: 'Get to know my work',
  perfisTexto: 'Publications, projects, interviews and behind-the-scenes from the classroom are in the links below.',
},
  es: {
  titulo: 'Sobre mí',
  abertura: 'Conecto tecnologías emergentes con proyectos educativos que llevan a instituciones, aulas y carreras hacia la transformación digital.',
  trajetoria: 'Soy profesor, investigador y doctor en Difusión del Conocimiento. En la Universidad SENAI CIMATEC coordino las carreras de Ingeniería de Computación y de Ciencia de Datos e Inteligencia Artificial, y soy responsable de la coordinación técnica de programas de posgrado.',
  impacto: 'Desarrollo productos tecnológicos y educativos que sacan la innovación del laboratorio y la ponen en uso. Como mentor, acompaño a equipos de estudiantes de la idea al podio: en 2026, Engage-Agent obtuvo el 2.º lugar mundial en el HackaStone, en Ámsterdam, y recibí el Mentor Award, uno de los 19 otorgados en el mundo.',
  frentesRotulo: 'Dónde actúo',
  frentes: [
    { titulo: 'Gestión académica', texto: 'Carreras de grado y programas de posgrado conectados con la industria.' },
    { titulo: 'Investigación aplicada', texto: 'IA en la educación, agentes inteligentes y tecnologías inmersivas.' },
    { titulo: 'Productos e innovación', texto: 'Soluciones tecnológicas y educativas, del concepto a la adopción.' },
    { titulo: 'Mentoría', texto: 'Equipos premiados en competencias internacionales de innovación.' },
  ],
  perfis: 'Conozca mi trabajo',
  perfisTexto: 'Publicaciones, proyectos, entrevistas y el día a día en el aula están en los siguientes enlaces.',
},
});
---

<Base idioma={idioma} pagina="inicio" titulo={i.titulo} descricao={i.descricao}>
  <section class="conteudo secao abre">
    <div class="coluna texto">
      <h1>{i.chamada[0]} <em>{i.chamada[1]}</em></h1>
      <p class="abertura">{i.resumo}</p>
      {pronta('sobre') && <div class="linha"><a class="italico" href={para('sobre')}>{i.verTrajetoria}</a></div>}
    </div>
    <FotosAbertura idioma={idioma} legenda={i.credenciais.join(' | ')} />
  </section>

  <section id="sobre" class="conteudo secao sobre" aria-labelledby="sobre-titulo">
    <div class="cabeca-secao"><h2 id="sobre-titulo">{sobre.titulo}</h2></div>
    <div class="sobre-grade">
      <div class="coluna">
        <p class="abertura sobre-abertura">{sobre.abertura}</p>
        <p>{sobre.trajetoria}</p>
        <p>{sobre.impacto}</p>
        <h3 class="rotulo destaque frentes-rotulo">{sobre.frentesRotulo}</h3>
        <ul class="frentes">
          {sobre.frentes.map((f) => <li><strong>{f.titulo}</strong><span>{f.texto}</span></li>)}
        </ul>
      </div>
      <aside class="coluna conheca" aria-labelledby="conheca-titulo">
        <h3 id="conheca-titulo">{sobre.perfis}</h3>
        <p class="apoio">{sobre.perfisTexto}</p>
        <Perfis />
      </aside>
    </div>
  </section>

  <section class="conteudo secao" aria-labelledby="destaques">
    <div class="cabeca-secao">
      <p class="rotulo destaque">{i.destaquesRotulo}</p>
      <h2 id="destaques">{i.destaquesTitulo}</h2>
    </div>
    <Carrossel idioma={idioma} rotulo={i.destaquesRotulo} automatico={7000}>
      {destaques.map((d, n) => (
        <li class="slide-destaque" aria-roledescription={tr(idioma, { pt: 'item', en: 'slide', es: 'diapositiva' })} aria-label={`${n + 1} / ${destaques.length}`}>
          <figure class="figura">
            {d.imagem
              ? <img class="foto-evento" src={endereco(d.imagem.arquivo)} width={d.imagem.largura} height={d.imagem.altura} alt={d.imagem.alt[idioma]} loading={n === 0 ? 'eager' : 'lazy'} decoding="async" />
              : <div class="espaco-foto sem-foto" aria-hidden="true">{txt.site.fotoEmBreve}</div>}
            {d.legenda && <figcaption>{d.legenda[idioma]}</figcaption>}
          </figure>
          <div class="coluna">
            <p class="rotulo destaque">{d.quando[idioma]}</p>
            <h3 class="titulo-destaque">{d.titulo[idioma]}</h3>
            <p>{d.texto[idioma]}</p>
            <div class="linha links">
              {d.links.map((l) => <a class="italico" href={l.url} rel="noopener">{l.rotulo[idioma]}<span class="so-leitor">: {d.titulo[idioma]}</span> <span aria-hidden="true">↗</span></a>)}
            </div>
          </div>
        </li>
      ))}
    </Carrossel>
  </section>

  {noticias.length > 0 && (
    <section class="conteudo secao" aria-labelledby="noticias">
      <div class="cabeca-secao">
        <p class="rotulo destaque">{i.noticiasRotulo}</p>
        <h2 id="noticias">{i.noticiasTitulo}</h2>
        <p class="apoio nota">{i.noticiasTexto}</p>
      </div>
      <article class="universidade" aria-labelledby="uni-titulo">
        <div class="uni-intro">
          <p class="rotulo destaque">{uni.rotulo[idioma]}</p>
          <h3 id="uni-titulo">{uni.titulo[idioma]} <span class="uni-recomendo">{uni.recomendo[idioma]}</span></h3>
          <p class="uni-resumo">{uni.resumo[idioma]}</p>
          <dl class="uni-indicadores">
            {uni.indicadores.map((d) => <div><dt>{d.valor}</dt><dd>{d.texto[idioma]}</dd></div>)}
          </dl>
        </div>
        <div class="uni-cursos">
          <p class="apoio uni-nota">{uni.nota[idioma]}</p>
          <ul>
            {uni.cursos.map((c) => (
              <li>
                <a class="curso" href={c.url} rel="noopener" target="_blank">
                  <span class="curso-nome">{c.nome[idioma]}</span>
                  <span class="curso-dados">{c.formato[idioma]} · {c.duracao[idioma]}</span>
                  <span class="curso-seta" aria-hidden="true">↗</span>
                  <span class="so-leitor"> ({uni.botaoCurso[idioma]}, {tr(idioma, { pt: 'abre em nova aba', en: 'opens in a new tab', es: 'se abre en una pestaña nueva' })})</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="uni-outros">
            {uni.outrosTitulo[idioma]}{' '}
            {uni.outros.map((o, k) => <>{k > 0 && <span aria-hidden="true"> · </span>}<a href={o.url} rel="noopener" target="_blank">{o.rotulo[idioma]}<span class="so-leitor"> — {uni.nome} ({tr(idioma, { pt: 'abre em nova aba', en: 'opens in a new tab', es: 'se abre en una pestaña nueva' })})</span></a></>)}
          </p>
        </div>
      </article>

      <Carrossel idioma={idioma} rotulo={i.noticiasTitulo} automatico={7000}>
        {noticias.map((n, k) => (
          <li class="nota-curadoria" aria-roledescription={tr(idioma, { pt: 'item', en: 'slide', es: 'diapositiva' })} aria-label={`${k + 1} / ${noticias.length}`}>
            <div class="nota-plataforma">
              <p class="nota-numero" aria-hidden="true">{String(k + 1).padStart(2, '0')}</p>
              <p class="apoio">{n.fonte} · {categorias[n.categoria][idioma]}</p>
              <h3>{n.titulo[idioma]}</h3>
              {n.etiquetas && <p class="nota-etiquetas">{n.etiquetas.map((e) => e[idioma]).join(' · ')}</p>}
            </div>
            <blockquote class="nota-texto">
              <p class="rotulo destaque">{tr(idioma, { pt: 'Por que recomendo', en: 'Why I recommend it', es: 'Por qué lo recomiendo' })}</p>
              <p>{n.porque[idioma]}</p>
              <a class="nota-link" href={n.url} rel="noopener" target="_blank">{i.noticiasElo} {n.titulo[idioma]}<span class="so-leitor"> ({tr(idioma, { pt: 'abre em nova aba', en: 'opens in a new tab', es: 'se abre en una pestaña nueva' })})</span> <span aria-hidden="true">↗</span></a>
            </blockquote>
          </li>
        ))}
      </Carrossel>
    </section>
  )}
</Base>

<style>
  .abre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    position: relative;
    isolation: isolate;
  }

  .abre::before { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:radial-gradient(ellipse at var(--luz-x, 78%) var(--luz-y, 42%), rgba(34,115,194,.2), transparent 65%); }
  .texto h1 { max-width: 14ch; }
  .texto {
    flex: 999 1 480px;
    min-width: 0;
    gap: 24px;
  }



  .sobre-grade { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px; }
  .sobre-abertura { font-size: clamp(21px, 2vw, 26px); line-height: 1.45; color: var(--papel); font-weight: 500; }
  .frentes-rotulo { margin-top: 12px; }
  .frentes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .frentes li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--fio);
    border-left: 3px solid var(--ciano);
    border-radius: 12px;
    background: rgba(12, 23, 41, .6);
  }
  .frentes strong { font-size: 17px; font-weight: 650; }
  .frentes span { font-size: 15px; line-height: 1.5; color: #d4dfed; }
  @media (max-width: 560px) { .frentes { grid-template-columns: 1fr; } }
  .conheca {
    align-self: start;
    padding: clamp(22px, 2.4vw, 30px);
    border: 1px solid rgba(130, 232, 242, .3);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(20, 40, 68, .9), rgba(9, 19, 35, .95));
  }
  @media (min-width: 761px) { .conheca { position: sticky; top: 24px; } }
  @media (max-width: 760px) { .sobre-grade { grid-template-columns: 1fr; } }

  .slide-destaque {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    align-items: start;
  }
  .sem-foto { aspect-ratio: 3 / 2; border-radius: 16px; border-color: rgba(139,188,255,.3); }
  .titulo-destaque { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.15; }
  .links { gap: 4px 24px; }

  .nota { max-width: 40em; }

  .universidade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 28px clamp(32px, 5vw, 72px);
    margin-bottom: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 56px);
    border-bottom: 1px solid var(--fio);
  }
  .uni-intro { display: flex; flex-direction: column; gap: 16px; }
  .universidade h3 { font-size: clamp(28px, 3vw, 40px); line-height: 1.1; letter-spacing: -.02em; }
  .uni-resumo { color: #d4dfed; font-size: 17px; line-height: 1.65; max-width: 34em; }
  .uni-recomendo { display: block; color: var(--ciano); }
  .uni-indicadores { margin: 8px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .uni-indicadores div { padding-top: 14px; border-top: 1px solid rgba(130, 232, 242, .35); }
  .uni-indicadores dt { font-size: clamp(30px, 3vw, 40px); font-weight: 700; letter-spacing: -.03em; line-height: 1; color: var(--papel); }
  .uni-indicadores dd { margin: 8px 0 0; font-size: 14px; line-height: 1.5; color: var(--nevoa); }
  @media (max-width: 480px) { .uni-indicadores { grid-template-columns: 1fr; } }
  .uni-cursos { display: flex; flex-direction: column; gap: 6px; }
  .uni-nota { text-transform: uppercase; letter-spacing: .12em; font-size: 11px; }
  .uni-cursos ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(130, 232, 242, .35); }
  .curso {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "nome seta" "dados seta";
    gap: 6px 16px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--fio);
    text-decoration: none;
  }
  .curso-nome { grid-area: nome; font-size: clamp(21px, 2.1vw, 27px); font-weight: 650; line-height: 1.2; letter-spacing: -.01em; transition: color .2s ease; }
  .curso-dados { grid-area: dados; font-family: var(--mono); font-size: 12px; color: var(--nevoa); }
  .curso-seta { grid-area: seta; font-size: 22px; color: var(--ciano); transition: transform .2s ease; }
  .curso:hover { color: var(--papel); }
  .curso:hover .curso-nome { color: var(--ciano); }
  .curso:hover .curso-seta { transform: translate(3px, -3px); }
  .uni-outros { margin-top: 14px; color: #d4dfed; font-size: 15px; line-height: 1.7; }
  .uni-outros a { color: var(--ciano); text-underline-offset: .2em; }
  @media (max-width: 860px) { .universidade { grid-template-columns: 1fr; } }

  .nota-curadoria {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 28px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .nota-plataforma { display: flex; flex-direction: column; gap: 10px; }
  .nota-numero { font-family: var(--mono); font-size: 13px; color: var(--ciano); letter-spacing: .1em; }
  .nota-plataforma h3 { font-size: clamp(34px, 4.4vw, 58px); line-height: 1.02; letter-spacing: -.035em; }
  .nota-etiquetas { font-family: var(--mono); font-size: 12px; color: var(--nevoa); letter-spacing: .04em; }
  .nota-texto { margin: 0; padding: 4px 0 4px clamp(20px, 2.4vw, 32px); border-left: 2px solid var(--ciano); display: flex; flex-direction: column; gap: 14px; }
  .nota-texto p:not(.rotulo) { font-size: clamp(19px, 1.8vw, 23px); line-height: 1.55; color: var(--papel); }
  .nota-link { align-self: flex-start; font-family: var(--mono); font-size: 13px; color: var(--ciano); text-underline-offset: .25em; padding: 10px 0; }
  .nota-link:hover { color: var(--papel); }
  @media (max-width: 760px) { .nota-curadoria { grid-template-columns: 1fr; } }

  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
