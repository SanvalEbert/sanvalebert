---
import { publicacoes } from '../data/publicacoes';
import { contatoWhatsApp, endereco, link, type Idioma } from '../data/site';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const pt = idioma === 'pt';
const textos = pt ? {
  abrir: 'Pergunte ao San', chamada: 'Pesquisas, publicações e contato', fechar: 'Fechar conversa', titulo: 'San · guia do portal',
  descricao: 'Respostas a partir do conteúdo do site', pergunta: 'O que você procura?', enviar: 'Enviar',
  boasVindas: 'Olá! Sou San, seu assistente virtual. Posso ajudar você a encontrar pesquisas, publicações, resultados de estudantes, palestras e formas de contato. O que gostaria de saber?',
  limite: 'Respondo com base no portal. Quando a IA estiver indisponível, consulto o catálogo local. Para outras informações, use o WhatsApp.',
  desconhecido: 'Não encontrei essa informação no conteúdo do portal. Você pode explorar as publicações ou falar diretamente com Sanval.',
  voce: 'Você', limpar: 'Limpar conversa',
  contato: 'Falar com Sanval no WhatsApp', pesquisa: 'Pesquisa e publicações',
  respostaContato: 'O contato divulgado pelo professor Sanval Ebert neste portal é o WhatsApp: (71) 98555-8490. Clique no link abaixo para conversar diretamente com ele.',
} : {
  abrir: 'Ask San', chamada: 'Research, publications and contact', fechar: 'Close conversation', titulo: 'San · portal guide',
  descricao: 'Answers from this website’s content', pergunta: 'What are you looking for?', enviar: 'Send',
  boasVindas: 'Hello! I’m San, your virtual assistant. I can help you find research, publications, student achievements, talks and contact details. What would you like to know?',
  limite: 'I answer from portal content, with local catalogue fallback when AI is unavailable. For other questions, use WhatsApp.',
  desconhecido: 'I couldn’t find that information in the portal content. You can explore the publications or contact Sanval directly.',
  voce: 'You', limpar: 'Clear conversation',
  contato: 'Contact Sanval on WhatsApp', pesquisa: 'Research and publications',
  respostaContato: 'Professor Sanval Ebert’s contact listed on this portal is WhatsApp: +55 71 98555-8490. Use the link below to contact him directly.',
};
const entradas = [
  {
    titulo: pt ? 'Sobre Sanval Ebert' : 'About Sanval Ebert', url: link('sobre', idioma),
    termos: 'sobre biografia perfil quem sanval coordenador professor docente pesquisador about biography profile who coordinator researcher',
    resumo: pt ? 'Sanval Ebert é docente e pesquisador na Universidade SENAI CIMATEC, onde coordena Engenharia de Computação e Ciência de Dados e Inteligência Artificial. Conecta educação, pesquisa e tecnologia.' : 'Sanval Ebert is an educator and researcher at SENAI CIMATEC University, coordinating Computer Engineering and Data Science and Artificial Intelligence. His work connects education, research and technology.',
  },
  {
    titulo: textos.pesquisa, url: link('pesquisa', idioma),
    termos: 'pesquisa publicacoes artigos research publications papers inteligencia artificial ia ai educacao education imersao realidade virtual metaverso',
    resumo: pt ? 'As pesquisas do portal abordam IA e ambientes de aprendizagem, experiências imersivas, modelagem de dados e formação profissional. O catálogo reúne artigos, capítulos, trabalhos de congresso e preprint, com fontes originais.' : 'The portal’s research covers AI and learning environments, immersive experiences, data modelling and professional training. The catalogue includes articles, chapters, conference papers and a preprint, with original sources.',
  },
  {
    titulo: pt ? 'Resultados · Engage-Agent' : 'Achievements · Engage-Agent', url: link('estudantes', idioma) + '#engage',
    termos: 'resultados estudantes alunos equipe engage agent hackastone hackathon amsterdam holanda segundo lugar premio students achievements team award',
    resumo: pt ? 'O Engage-Agent, equipe orientada por Sanval Ebert, conquistou o segundo lugar mundial no HackaStone 2026, em Amsterdam. O projeto acompanha o percurso de aprendizagem e apoia o professor. Conheça a equipe e os registros na página de Resultados.' : 'Engage-Agent, the team mentored by Sanval Ebert, placed second worldwide at HackaStone 2026 in Amsterdam. The project follows learning progress and supports teachers. Meet the team and see the records on the Achievements page.',
  },
  {
    titulo: pt ? 'Serviços TechEdu' : 'TechEdu Services', url: link('servicos', idioma),
    termos: 'serviços servicos services training treinamentos minicursos short courses workshops palestras talks cursos formação formacao capacitação capacitacao inscrição inscricao interesse',
    resumo: pt ? 'O TechEdu apresenta quatro modalidades: palestras, treinamentos, minicursos e workshops. Conheça os formatos na página de Serviços. Nesta etapa, interessados podem conversar pelo WhatsApp; o cadastro Google ainda não está ativo.' : 'TechEdu offers four formats: talks, training, short courses and workshops. Explore the Services page. For now, visitors may contact Sanval via WhatsApp; Google sign-in is not active yet.',
  },
  {
    titulo: pt ? 'Palestras e eventos' : 'Talks and events', url: link('palestras', idioma),
    termos: 'palestra evento formacao curso oficina workshop contratar proposta preco valor agenda disponibilidade talk event training course hire proposal price schedule contact contato whatsapp',
    resumo: pt ? 'O portal apresenta temas de palestras sobre educação, IA e tecnologias emergentes. Para consultar disponibilidade, valores ou solicitar uma proposta para seu evento ou formação, converse com Sanval pelo WhatsApp.' : 'The portal presents talks on education, AI and emerging technologies. To check availability, pricing or request a proposal for an event or training programme, contact Sanval on WhatsApp.',
  },
  ...publicacoes.map(p => ({ titulo: p.title, url: p.doi ? `https://doi.org/${p.doi}` : `https://www.researchgate.net/publication/${p.rg}`, termos: `${p.title} ${p.authors} ${p.year} ${p.area}`, resumo: `${p.year} · ${p.venue}. ${p.summary[idioma]}` })),
];
const config = JSON.stringify({ textos, entradas, contatoWhatsApp, pesquisa: link('pesquisa', idioma), pt });
---
<div class="san" data-san data-config={config}>
  <button class="san-abrir" data-san-abrir type="button" aria-haspopup="dialog" aria-controls="san-painel" title={textos.abrir}>
    <span class="san-avatar" aria-hidden="true"><img src={endereco('images/san-avatar-3d.webp')} width="64" height="64" alt="" loading="lazy" /></span>
    <span class="san-cta"><strong>{textos.abrir}</strong><small>{textos.chamada}</small></span>
    <span class="san-luz" aria-hidden="true"></span>
  </button>
  <dialog id="san-painel" aria-labelledby="san-titulo" aria-describedby="san-descricao">
    <header class="san-cabeca">
      <img src={endereco('images/san-avatar-3d.webp')} width="64" height="61" alt="" loading="lazy" />
      <div><h2 id="san-titulo">{textos.titulo}</h2><p id="san-descricao">{textos.descricao}</p></div>
      <button class="san-fechar" data-san-fechar aria-label={textos.fechar}>×</button>
    </header>
    <div class="san-historico" role="log" aria-live="polite" aria-relevant="additions" aria-label={pt ? 'Conversa com San' : 'Conversation with San'} data-san-historico></div>
    <div class="san-sugestoes" aria-label={pt ? 'Sugestões de perguntas' : 'Suggested questions'}>
      {[pt ? 'Pesquisas' : 'Research', pt ? 'Publicações' : 'Publications', pt ? 'Palestras' : 'Talks', pt ? 'Contato' : 'Contact'].map(s => <button type="button" data-san-sugestao>{s}</button>)}
    </div>
    <form class="san-form" data-san-form>
      <label for="san-pergunta">{textos.pergunta}</label>
      <div><input id="san-pergunta" name="pergunta" type="text" maxlength="500" required autocomplete="off" /><button type="submit">{textos.enviar}</button></div>
    </form>
    <div class="san-rodape"><p>{textos.limite}</p><button type="button" data-san-limpar>{textos.limpar}</button></div>
  </dialog>
</div>
<script>
  interface Entrada { titulo: string; url: string; termos: string; resumo: string }
  const raiz = document.querySelector<HTMLElement>('[data-san]');
  if (raiz) {
    const config = JSON.parse(raiz.dataset.config!);
    const entradas: Entrada[] = config.entradas;
    const txt = config.textos;
    const painel = raiz.querySelector<HTMLDialogElement>('dialog')!;
    const abrir = raiz.querySelector<HTMLButtonElement>('[data-san-abrir]')!;
    const historico = raiz.querySelector<HTMLElement>('[data-san-historico]')!;
    const campo = raiz.querySelector<HTMLInputElement>('input')!;
    const normalizar = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const singular = (s: string) => s.length > 4 ? s.replace(/s$/, '') : s;
    const historicoIA: { papel: 'usuario' | 'assistente'; texto: string }[] = [];
    const ignorar = new Set(['para','como','sobre','quero','saber','qual','quais','pode','voce','gostaria','conhecer','with','what','about','would','like','know','does','from','that','this','your','mais','fale','portal']);
    function mensagem(texto: string, usuario = false, fontes: {titulo:string;url:string}[] = []) {
      const bloco = document.createElement('div');
      bloco.className = usuario ? 'san-mensagem san-usuario' : 'san-mensagem';
      const nome = document.createElement('strong'); nome.textContent = usuario ? txt.voce : 'San';
      const p = document.createElement('p'); p.textContent = texto;
      bloco.append(nome, p);
      if (fontes.length) {
        const lista = document.createElement('ul');
        for (const fonte of fontes) {
          const item = document.createElement('li'); const a = document.createElement('a');
          a.textContent = fonte.titulo; a.href = fonte.url; item.append(a); lista.append(item);
        }
        bloco.append(lista);
      }
      historico.append(bloco);
      // Keep the conversation bounded and in memory only.
      while (historico.childElementCount > 41) historico.firstElementChild?.remove();
      bloco.scrollIntoView({block:'nearest'});
      return bloco;
    }
    async function responder(pergunta: string) {
      const texto = pergunta.trim().slice(0, 500);
      if (!texto) return;
      mensagem(texto, true);
      const n = normalizar(texto);
      // Contact requests take priority over biography and publication matches.
      // They do not require spelling the professor's name correctly.
      if (/\b(contato|contact|telefone|phone|telephone|celular|whatsapp|whats|zap|numero|number|email|e-mail|reach)\b/.test(n) || /\b(falar|conversar)\s+(diretamente\s+)?com\b|\b(talk|speak)\s+(to|with)\b/.test(n)) {
        mensagem(txt.respostaContato, false, [{titulo:txt.contato, url:config.contatoWhatsApp}]);
        return;
      }
      if (/^(oi|ola|hello|hi|bom dia|boa tarde|boa noite)[!.\s]*$/.test(n)) { mensagem(txt.boasVindas); return; }
      if (/^(obrigad[oa]|thanks|thank you)[!.\s]*$/.test(n)) { mensagem(config.pt ? 'Por nada! O que mais gostaria de explorar?' : 'You’re welcome! What else would you like to explore?'); return; }
      const tokens = [...new Set(n.split(/[^a-z0-9]+/).filter(t => (t.length > 2 || t === 'ia' || t === 'ai') && !ignorar.has(t)).map(singular))];
      const resultados = entradas.map(e => {
        const palavras = normalizar(`${e.termos} ${e.titulo} ${e.resumo}`).split(/[^a-z0-9]+/).map(singular);
        const titulo = normalizar(e.titulo).split(/[^a-z0-9]+/).map(singular);
        const score = tokens.reduce((s, t) => s + (titulo.includes(t) ? 6 : palavras.includes(t) ? 3 : palavras.some(p => t.length >= 5 && p.startsWith(t)) ? 1 : 0), 0);
        return { e, score };
      }).filter(r => r.score > 0).sort((a,b) => b.score - a.score).slice(0,3);
      if (!resultados.length) {
        mensagem(txt.desconhecido, false, [{titulo:txt.pesquisa, url:config.pesquisa}, {titulo:txt.contato, url:config.contatoWhatsApp}]);
        return;
      }
      const fontes = [...resultados.map(r => ({titulo:r.e.titulo,url:r.e.url})), {titulo:txt.contato,url:config.contatoWhatsApp}];
      const respostaLocal = resultados[0].e.resumo;
      const pendente = mensagem(config.pt ? 'Consultando as informações do portal…' : 'Checking portal information…');
      let respostaFinal = respostaLocal;
      try {
        const controlador = new AbortController();
        const tempo = setTimeout(() => controlador.abort(), 9000);
        try {
          const retorno = await fetch(`${import.meta.env.BASE_URL}api/chat`, {
            method: 'POST',
            signal: controlador.signal,
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
              pergunta: texto,
              idioma: config.pt ? 'pt' : 'en',
              referencias: resultados.map(r => ({titulo:r.e.titulo, resumo:r.e.resumo, url:r.e.url})),
              historico: historicoIA.slice(-4),
            }),
          });
          if (retorno.ok) {
            const dados: {resposta?: string} = await retorno.json();
            if (typeof dados.resposta === 'string' && dados.resposta.trim()) respostaFinal = dados.resposta.trim();
          }
        } finally {
          clearTimeout(tempo);
        }
      } catch {
        // Sem rede, credenciais ou serviço: usa o catálogo local, sem interromper a conversa.
      }
      pendente.remove();
      mensagem(respostaFinal, false, fontes);
      historicoIA.push({papel: 'usuario', texto}, {papel: 'assistente', texto: respostaFinal});
      if (historicoIA.length > 6) historicoIA.splice(0, historicoIA.length - 6);
    }
    abrir.addEventListener('click', () => { painel.showModal(); if (!historico.childElementCount) mensagem(txt.boasVindas); campo.focus(); });
    raiz.querySelector('[data-san-fechar]')!.addEventListener('click', () => painel.close());
    painel.addEventListener('close', () => abrir.focus());
    raiz.querySelector('[data-san-form]')!.addEventListener('submit', e => { e.preventDefault(); responder(campo.value); campo.value = ''; campo.focus(); });
    raiz.querySelectorAll<HTMLButtonElement>('[data-san-sugestao]').forEach(b => b.addEventListener('click', () => responder(b.textContent || '')));
    raiz.querySelector('[data-san-limpar]')!.addEventListener('click', () => { historico.replaceChildren(); historicoIA.length = 0; mensagem(txt.boasVindas); campo.focus(); });
  }
</script>
<style>
  .san { position:fixed;right:16px;bottom:16px;z-index:8;font-family:var(--sans); }
  .san button,.san input { font:inherit; }
  .san button { cursor:pointer;min-height:44px;border:1px solid #46617c;color:#eff6ff;background:#10243c;border-radius:12px;padding:8px 12px; }
  .san button:hover { background:#1b3b5c; }
  .san button:focus-visible,.san input:focus-visible { outline:3px solid #82e8f2;outline-offset:3px; }
  /* Lançador em coluna: avatar em cima e rótulo embaixo, ocupando o corredor lateral da página. */
  .san-abrir {
    display:flex;flex-direction:column;align-items:center;gap:6px;width:84px;
    border-radius:20px!important;padding:8px 6px 10px!important;position:relative;
    background:linear-gradient(180deg,#10243c,#0a1e35)!important;
    border:1px solid rgba(130,232,242,.4)!important;
    box-shadow:0 10px 34px rgba(0,0,0,.35),0 0 18px rgba(36,82,223,.17);
    text-align:center;transition:transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .san-abrir:hover { transform:translateY(-2px);border-color:#82e8f2!important;box-shadow:0 15px 42px #0007,0 0 22px #2452df44; }
  .san-avatar { width:56px;height:56px;flex:none;display:grid;place-items:center;overflow:hidden;border-radius:50%;background:radial-gradient(circle at 45% 30%,#284e72,#102037 76%);border:1px solid rgba(130,232,242,.4); }
  .san-avatar img {width:58px;height:58px;object-fit:contain;display:block;}
  .san-cta { display:flex;flex-direction:column;min-width:0; }
  .san-cta strong {font-size:11px;line-height:1.2;font-weight:650;color:#f2f7ff;}
  .san-cta small {position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;}
  .san-luz {position:absolute;top:10px;right:12px;width:8px;height:8px;background:#82e8f2;border-radius:50%;box-shadow:0 0 10px #82e8f266;}
  .san img { object-fit:contain;flex-shrink:0; }
  .san dialog {
    position:fixed;inset:auto 16px 132px auto;margin:0;padding:0;
    width:min(400px,calc(100vw - 32px));height:min(640px,calc(100dvh - 150px));
    max-height:calc(100dvh - 150px);color:#eff6ff;background:#091525;
    border:1px solid #46617c;border-radius:20px;box-shadow:0 20px 80px #0009;
  }
  .san dialog[open] {display:flex;flex-direction:column;}
  .san dialog::backdrop {background:#02081299;}
  .san-cabeca {padding:16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #29435c;}
  .san-cabeca div {flex:1;} .san-cabeca h2 {font:600 16px var(--sans);margin:0 0 5px;} .san-cabeca p {font-size:12px;color:#b3c2d8;margin:0;}
  .san-fechar {font-size:24px!important;padding:0!important;min-width:44px;}
  .san-historico {overflow:auto;flex:1;min-height:80px;padding:16px;overscroll-behavior:contain;}
  .san-mensagem {padding:12px;background:#10243c;border-radius:12px;margin-bottom:12px;font-size:14px;line-height:1.55;overflow-wrap:anywhere;}
  .san-mensagem strong {color:#82e8f2;font-size:12px;} .san-mensagem p {margin:6px 0 0;} .san-mensagem ul {margin:10px 0 0;padding-left:18px;} .san-mensagem li {margin:8px 0;} .san-mensagem a {color:#a9ecff;}
  .san-usuario {background:#18334e;margin-left:24px;}
  .san-sugestoes {display:flex;gap:6px;flex-wrap:wrap;padding:0 16px 10px;}
  .san-sugestoes button {font-size:12px;border-radius:999px;}
  .san-form {padding:0 16px;} .san-form label {display:block;font-size:12px;margin-bottom:7px;} .san-form div {display:flex;gap:8px;}
  .san-form input {min-width:0;flex:1;color:#eff6ff;background:#060c18;border:1px solid #67839d;border-radius:10px;padding:10px;font-size:16px;}
  .san-rodape {padding:10px 16px;display:flex;align-items:center;gap:10px;} .san-rodape p {font-size:11px;line-height:1.5;color:#b3c2d8;margin:0;flex:1;} .san-rodape button {font-size:11px;max-width:95px;}
  @media(max-width:540px) {
    .san {right:10px;bottom:10px;}
    .san-abrir {width:64px;padding:6px!important;border-radius:999px!important;}
    .san-avatar {width:50px;height:50px;} .san-avatar img {width:52px;height:52px;}
    .san-cta strong {position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;}
    .san-luz {top:6px;right:6px;}
    .san dialog {right:8px;bottom:84px;width:calc(100vw - 16px);max-width:calc(100vw - 16px);height:min(640px,calc(100dvh - 100px));max-height:calc(100dvh - 100px);}
  }
  @media(max-height:530px) {
    .san dialog {inset:8px!important;width:calc(100vw - 16px);max-width:calc(100vw - 16px);height:calc(100dvh - 16px);max-height:calc(100dvh - 16px);}
  }
  @media(prefers-reduced-motion:reduce) {.san-abrir {transition:none;}}
  @media print {.san {display:none;}}
</style>
