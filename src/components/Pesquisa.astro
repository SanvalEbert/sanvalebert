---
import { tr } from '../i18n/tr';
import Base from '../layouts/Base.astro';
import { publicacoes, fontesPesquisa } from '../data/publicacoes';
import { endereco, type Idioma } from '../data/site';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const areas: Record<string,string> = tr(idioma, { pt: {ia:'IA e aprendizagem',imersao:'Tecnologias imersivas',dados:'Dados e sinais',formacao:'Formação profissional'}, en: {ia:'AI and learning',imersao:'Immersive technologies',dados:'Data and signals',formacao:'Professional training'}, es: {ia:'IA y aprendizaje',imersao:'Tecnologías inmersivas',dados:'Datos y señales',formacao:'Formación profesional'} });
const tipos: Record<string,string> = tr(idioma, { pt: {artigo:'Artigo',capitulo:'Capítulo',congresso:'Trabalho de congresso',preprint:'Preprint'}, en: {artigo:'Journal article',capitulo:'Book chapter',congresso:'Conference paper',preprint:'Preprint'}, es: {artigo:'Artículo',capitulo:'Capítulo',congresso:'Trabajo de congreso',preprint:'Preprint'} });
const principal = publicacoes.find(p => p.id === 'etd')!;
const destaques = ['agentes','paa'].map(id => publicacoes.find(p => p.id === id)!);
const rg = (id: string) => 'https://www.researchgate.net/publication/' + id;
const titulo = tr(idioma, { pt: 'Pesquisa e publicações · Sanval Ebert', en: 'Research and publications · Sanval Ebert', es: 'Investigación y publicaciones · Sanval Ebert' });
const descricao = tr(idioma, { pt: 'Conheça as pesquisas de Sanval Ebert em inteligência artificial, educação e tecnologias emergentes. Artigos, capítulos e projetos com acesso às fontes originais.', en: 'Explore Sanval Ebert’s research in artificial intelligence, education and emerging technologies, with publications and links to original sources.', es: 'Conozca las investigaciones de Sanval Ebert en inteligencia artificial, educación y tecnologías emergentes, con publicaciones y acceso a las fuentes originales.' });
---
<Base idioma={idioma} pagina="pesquisa" titulo={titulo} descricao={descricao}>
 <section class="conteudo secao coluna abertura-pesquisa">
  <p class="rotulo destaque">{tr(idioma, { pt: 'Pesquisa', en: 'Research', es: 'Investigación' })}</p>
  <h1 class="titulo-pagina">{tr(idioma, { pt: 'Inteligência artificial, tecnologias emergentes e', en: 'Artificial intelligence, emerging technologies and', es: 'Inteligencia artificial, tecnologías emergentes y' })} <em>{tr(idioma, { pt: 'educação.', en: 'education.', es: 'educación.' })}</em></h1>
  <p class="abertura">{tr(idioma, { pt: 'Investigo como a tecnologia pode ampliar as possibilidades de ensinar e aprender. Aqui reúno trabalhos de autoria e coautoria, suas contribuições e as questões que conectam a pesquisa à prática.', en: 'I investigate how technology can expand opportunities for teaching and learning. Here I bring together authored and co-authored work and the questions connecting research and practice.', es: 'Investigo cómo la tecnología puede ampliar las posibilidades de enseñar y aprender. Aquí reúno trabajos de autoría y coautoría, sus aportes y las preguntas que conectan la investigación con la práctica.' })}</p>
  <div class="linha"><a class="botao" href="#publicacoes">{tr(idioma, { pt: 'Explorar publicações', en: 'Explore publications', es: 'Explorar publicaciones' })}</a><a class="italico" href={fontesPesquisa.researchgate}>ResearchGate ↗</a><a class="italico" href={fontesPesquisa.scholar}>Google Scholar ↗</a></div>
  <p class="apoio">{tr(idioma, { pt: '13 publicações no catálogo · 7 artigos em periódicos · 2020–2026', en: '13 publications in the catalogue · 7 journal articles · 2020–2026', es: '13 publicaciones en el catálogo · 7 artículos en revistas · 2020–2026' })}</p>
 </section>
 <section class="conteudo secao" aria-labelledby="linhas">
  <div class="cabeca-secao"><h2 id="linhas">{tr(idioma, { pt: 'Questões que orientam meus estudos', en: 'Questions guiding my research', es: 'Preguntas que orientan mis estudios' })}</h2></div>
  <div class="grade eixos">
   <article class="celula"><h3>{tr(idioma, { pt: 'IA e ambientes de aprendizagem', en: 'AI and learning environments', es: 'IA y entornos de aprendizaje' })}</h3><p>{tr(idioma, { pt: 'Agentes inteligentes, personalização e apoio ao trabalho docente. Como integrar IA ao planejamento e ao acompanhamento da aprendizagem?', en: 'Intelligent agents, personalisation and teacher support. How can AI support planning and the understanding of student progress?', es: 'Agentes inteligentes, personalización y apoyo al trabajo docente. ¿Cómo integrar la IA a la planificación y al seguimiento del aprendizaje?' })}</p></article>
   <article class="celula"><h3>{tr(idioma, { pt: 'Experiências imersivas', en: 'Immersive experiences', es: 'Experiencias inmersivas' })}</h3><p>{tr(idioma, { pt: 'Realidade virtual, metaverso e interação humano-computador. Como criar e avaliar experiências que ajudem a compreender conceitos e explorar ambientes?', en: 'Virtual reality, metaverse and human-computer interaction. How can we create and evaluate experiences that help people understand concepts and explore environments?', es: 'Realidad virtual, metaverso e interacción humano-computadora. ¿Cómo crear y evaluar experiencias que ayuden a comprender conceptos y explorar entornos?' })}</p></article>
   <article class="celula"><h3>{tr(idioma, { pt: 'Colaborações e formação', en: 'Collaboration and training', es: 'Colaboraciones y formación' })}</h3><p>{tr(idioma, { pt: 'Modelagem de dados e sinais biomédicos, além da formação profissional em tecnologia. Colaborações que ampliam o diálogo entre educação e outras áreas do conhecimento.', en: 'Data modelling and biomedical signals, alongside professional training in technology. Collaborations extending the dialogue between education and other fields.', es: 'Modelado de datos y señales biomédicas, además de la formación profesional en tecnología. Colaboraciones que amplían el diálogo entre la educación y otras áreas del conocimiento.' })}</p></article>
  </div>
 </section>
 <section class="conteudo secao" aria-labelledby="destaques">
  <div class="cabeca-secao"><p class="rotulo destaque">{tr(idioma, { pt: 'Por onde começar', en: 'Where to start', es: 'Por dónde empezar' })}</p><h2 id="destaques">{tr(idioma, { pt: 'Trabalhos em destaque', en: 'Featured publications', es: 'Trabajos destacados' })}</h2></div>
  <article class="principal">
   <div class="coluna"><p class="apoio">{principal.year} · {principal.venue}</p><h3>{principal.title}</h3><p>{principal.summary[idioma]}</p><p class="apoio">{principal.authors}</p>
    <div class="linha"><a class="botao" href={'https://doi.org/' + principal.doi}>{tr(idioma, { pt: 'Ler o artigo', en: 'Read the article', es: 'Leer el artículo' })} ↗</a><a class="italico" href={rg(principal.rg)}>ResearchGate ↗</a></div>
   </div>
   <aside class="alcance" aria-label={tr(idioma, { pt: 'Citações deste artigo', en: 'Citations for this article', es: 'Citas de este artículo' })}><p class="numero">{fontesPesquisa.citacoesDestaque}</p><p>{tr(idioma, { pt: 'citações deste artigo no ResearchGate', en: 'citations for this article on ResearchGate', es: 'citas de este artículo en ResearchGate' })}</p><p class="apoio">{tr(idioma, { pt: 'Contagem no registro consultado em 15/11/2026.', en: 'Count in the record consulted on 15 November 2026.', es: 'Conteo en el registro consultado el 15/11/2026.' })}</p><a class="italico" href={rg(principal.rg)}>{tr(idioma, { pt: 'Consultar registro', en: 'View record', es: 'Consultar registro' })} ↗</a></aside>
  </article>
  <div class="grade secundarios">{destaques.map(p => <article class="celula coluna"><p class="apoio">{p.year} · {p.venue}</p><h3>{p.title}</h3><p>{p.summary[idioma]}</p><a class="italico" href={'https://doi.org/' + p.doi}>{tr(idioma, { pt: 'Conhecer o trabalho', en: 'Explore this work', es: 'Conocer el trabajo' })} ↗</a></article>)}</div>
 </section>
 <section class="conteudo secao" aria-labelledby="conexoes">
  <div class="cabeca-secao"><h2 id="conexoes">{tr(idioma, { pt: 'Da investigação às experiências de aprendizagem', en: 'From research to learning experiences', es: 'De la investigación a las experiencias de aprendizaje' })}</h2></div>
  <div class="conexoes coluna">
   <p class="abertura">{tr(idioma, { pt: 'Os trabalhos se conectam por uma pergunta: como aproximar as possibilidades da tecnologia das necessidades de quem ensina e aprende?', en: 'These studies share a question: how can technological possibilities meet the needs of teachers and learners?', es: 'Los trabajos se conectan por una pregunta: ¿cómo acercar las posibilidades de la tecnología a las necesidades de quienes enseñan y aprenden?' })}</p>
   <p>{tr(idioma, { pt: 'Os estudos de 2021 discutem a integração de IA aos ambientes virtuais. A revisão sobre agentes inteligentes amplia esse olhar; os modelos conceituais exploram novas formas de organizar a aprendizagem e apoiar o planejamento docente. Os trabalhos de imersão acrescentam outra dimensão: experimentar e compreender conceitos em ambientes virtuais.', en: 'The 2021 studies discuss integrating AI into virtual environments. The review of intelligent agents broadens this perspective; conceptual models explore ways to organise learning and support teacher planning. The immersive studies add another dimension: experiencing and understanding concepts in virtual environments.', es: 'Los estudios de 2021 discuten la integración de la IA a los entornos virtuales. La revisión sobre agentes inteligentes amplía esa mirada; los modelos conceptuales exploran nuevas formas de organizar el aprendizaje y apoyar la planificación docente. Los trabajos de inmersión añaden otra dimensión: experimentar y comprender conceptos en entornos virtuales.' })}</p>
   <p>{tr(idioma, { pt: 'Essas questões também dialogam com minha atuação na orientação de estudantes. No Engage-Agent, equipe que orientei e que conquistou o segundo lugar mundial no HackaStone 2026, o foco é acompanhar o percurso de aprendizagem e apoiar o professor.', en: 'These questions also connect with my work mentoring students. Engage-Agent, the team I mentored that placed second worldwide at HackaStone 2026, focuses on following learning progress and supporting teachers.', es: 'Estas preguntas también dialogan con mi trabajo como mentor de estudiantes. En Engage-Agent, el equipo que orienté y que obtuvo el segundo lugar mundial en el HackaStone 2026, el foco es acompañar el recorrido de aprendizaje y apoyar al docente.' })}</p>
   <a class="italico" href={endereco((tr(idioma, { pt: 'estudantes/', en: 'en/students/', es: 'es/resultados/' })) + '#engage')}>{tr(idioma, { pt: 'Conhecer o projeto Engage-Agent', en: 'Explore the Engage-Agent project', es: 'Conocer el proyecto Engage-Agent' })} →</a>
  </div>
 </section>
 <section id="publicacoes" class="conteudo secao" aria-labelledby="catalogo">
  <div class="cabeca-secao"><h2 id="catalogo">{tr(idioma, { pt: 'Publicações', en: 'Publications', es: 'Publicaciones' })}</h2><p>{tr(idioma, { pt: 'Artigos, capítulos, trabalhos de congresso e preprint. Os títulos foram preservados no idioma de publicação; a autoria completa e os textos estão nos registros originais.', en: 'Journal articles, book chapters, conference papers and a preprint. Titles retain their original language; complete authorship and texts are available in the original records.', es: 'Artículos, capítulos, trabajos de congreso y un preprint. Los títulos se conservan en el idioma de publicación; la autoría completa y los textos están en los registros originales.' })}</p></div>
  <form class="filtros" data-filtros hidden role="search" aria-label={tr(idioma, { pt: 'Buscar publicações', en: 'Search publications', es: 'Buscar publicaciones' })}>
   <label>{tr(idioma, { pt: 'Buscar por título, autor ou tema', en: 'Search by title, author or topic', es: 'Buscar por título, autor o tema' })}<input type="search" name="busca" autocomplete="off" /></label>
   <div class="campo"><label for="area-pesquisa">{tr(idioma, { pt: 'Área', en: 'Area', es: 'Área' })}</label><select id="area-pesquisa" name="area"><option value="">{tr(idioma, { pt: 'Todas as áreas', en: 'All areas', es: 'Todas las áreas' })}</option>{Object.entries(areas).map(([valor,nome]) => <option value={valor}>{nome}</option>)}</select></div>
  </form>
  <p class="apoio resultado-busca" role="status" data-contagem data-singular={tr(idioma, { pt: 'publicação', en: 'publication', es: 'publicación' })} data-plural={tr(idioma, { pt: 'publicações', en: 'publications', es: 'publicaciones' })}>{publicacoes.length} {tr(idioma, { pt: 'publicações', en: 'publications', es: 'publicaciones' })}</p>
  <ol class="lista-publicacoes">{publicacoes.map(p => <li class="publicacao" data-publicacao data-area={p.area} data-busca={[p.title,p.authors,p.venue,p.summary[idioma],areas[p.area]].join(' ')}><p class="ano">{p.year}</p><article class="coluna">
   <p class="apoio">{tipos[p.type]} · {areas[p.area]}</p><h3>{p.title}</h3><p class="apoio">{p.venue}</p><p>{p.summary[idioma]}</p><p class="autoria">{p.authors}</p>
   {p.note && <p class="apoio">{p.note[idioma]}</p>}
   <div class="linha">{p.doi && <a class="italico" href={'https://doi.org/' + p.doi}>{tr(idioma, { pt: 'Publicação e DOI', en: 'Publication and DOI', es: 'Publicación y DOI' })} ↗<span class="so-leitor">: {p.title}</span></a>}<a class="italico" href={rg(p.rg)}>ResearchGate ↗<span class="so-leitor">: {p.title}</span></a></div>
  </article></li>)}</ol>
  <p data-vazio hidden>{tr(idioma, { pt: 'Nenhuma publicação encontrada. Tente outro termo ou selecione todas as áreas.', en: 'No publications found. Try another term or select all areas.', es: 'No se encontraron publicaciones. Pruebe otro término o seleccione todas las áreas.' })}</p>
  <p class="apoio fontes">{tr(idioma, { pt: 'Catálogo organizado a partir do ResearchGate e dos registros dos periódicos e editoras, consultados em 15/11/2026. Citações e leituras variam entre plataformas e ao longo do tempo.', en: 'Catalogue compiled from ResearchGate, journal and publisher records consulted on 15 November 2026. Citation and read counts vary across platforms and over time.', es: 'Catálogo organizado a partir de ResearchGate y de los registros de revistas y editoriales, consultados el 15/11/2026. Las citas y lecturas varían entre plataformas y con el tiempo.' })} <a href={fontesPesquisa.researchgate}>ResearchGate</a> · <a href={fontesPesquisa.scholar}>Google Scholar</a></p>
 </section>
</Base>
<script>
 const form = document.querySelector<HTMLFormElement>('[data-filtros]');
 const busca = form?.querySelector<HTMLInputElement>('input');
 const area = form?.querySelector<HTMLSelectElement>('select');
 const itens = Array.from(document.querySelectorAll<HTMLElement>('[data-publicacao]'));
 const contagem = document.querySelector<HTMLElement>('[data-contagem]');
 const vazio = document.querySelector<HTMLElement>('[data-vazio]');
 const normalizar = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
 function filtrar() {
  const termo = normalizar(busca?.value ?? '').trim(); let total = 0;
  for (const item of itens) { const aparece = normalizar(item.dataset.busca ?? '').includes(termo) && (!area?.value || item.dataset.area === area.value); item.hidden = !aparece; if (aparece) total++; }
  if (contagem) contagem.textContent = `${total} ${total === 1 ? contagem.dataset.singular : contagem.dataset.plural}`;
  if (vazio) vazio.hidden = total > 0;
 }
 if (form) { form.hidden = false; form.addEventListener('submit', e => e.preventDefault()); busca?.addEventListener('input',filtrar); area?.addEventListener('change',filtrar); }
</script>
<style>
.abertura-pesquisa{gap:24px}.eixos{grid-template-columns:repeat(auto-fit,minmax(min(290px,100%),1fr))}
.principal{display:grid;grid-template-columns:minmax(0,2fr) minmax(180px,1fr);gap:40px;padding:clamp(22px,3vw,36px);border:1px solid rgba(130,232,242,.35);border-radius:22px;background:radial-gradient(ellipse at 100% 0%,rgba(28,100,145,.18),transparent 65%),var(--painel);box-shadow:0 24px 60px rgba(0,0,0,.15)}
.principal h3{font-size:clamp(26px,3vw,36px);line-height:1.14}.alcance{border-left:1px solid var(--fio);padding-left:28px;display:flex;flex-direction:column;gap:14px}.numero{font-size:88px;line-height:1;color:var(--azul-claro)}
.secundarios{grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));margin-top:20px}.conexoes{max-width:900px}
.filtros{display:grid;grid-template-columns:minmax(0,2fr) minmax(180px,1fr);gap:20px;margin:28px 0 20px}.filtros[hidden],.publicacao[hidden]{display:none}.filtros .campo{display:flex;flex-direction:column;gap:8px}.filtros label{display:flex;flex-direction:column;gap:8px;font-family:var(--mono);font-size:13px}
input,select{font:inherit;min-height:48px;color:var(--papel);background:var(--noite);border:1px solid var(--nevoa);padding:12px;width:100%;border-radius:10px}
.resultado-busca{margin-bottom:18px}.lista-publicacoes{list-style:none;padding:0;margin:0}.publicacao{display:grid;grid-template-columns:80px minmax(0,1fr);gap:28px;padding:30px 0;border-top:1px solid var(--fio)}.ano{font-family:var(--mono);font-size:18px;color:var(--azul-claro)}.publicacao .coluna{gap:10px}.publicacao h3{font-size:clamp(23px,2.5vw,30px);line-height:1.2;overflow-wrap:anywhere}.autoria{font-size:16px;color:var(--nevoa)}.fontes{margin-top:28px}
.so-leitor{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:640px){.principal,.filtros{grid-template-columns:1fr;gap:24px}.alcance{border-left:0;border-top:1px solid var(--fio);padding:20px 0 0}.numero{font-size:64px}.publicacao{grid-template-columns:1fr;gap:12px}}
</style>
